# ─── Database ───
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/keyword_analyzer
DB_HOST=localhost
DB_PORT=5432
DB_NAME=keyword_analyzer
DB_USER=postgres
DB_PASSWORD=yourpassword

# ─── Server ───
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
SESSION_SECRET=a-very-long-random-secret-key-at-least-32-chars

# ─── CORS ───
# In production, set to your domain (e.g. https://keyword.yourdomain.com)
# Leave empty to block all cross-origin requests in production
CORS_ORIGIN=

# ─── SERP Data (Required) ───
# Get free key at https://serper.dev
SERPER_API_KEY=

# ─── Shared Google Service Account (Preferred for GSC + GA4) ───
# Paste one service account JSON here when the same account has both GSC and GA4 access.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ─── Google Search Console (Service Account) ───
# Guide: https://console.cloud.google.com → IAM → Service Accounts → Create → Download JSON key
# Then in each client's GSC: Settings → Users & permissions → Add user → paste service account email
# Paste the ENTIRE JSON key file content as a single line below:
GSC_SERVICE_ACCOUNT_JSON=
# How many days of data to pull on each daily sync (default: 30)
GSC_SYNC_DAYS=30

# ─── Google Analytics 4 (Service Account) ───
# Optional fallback if you do not use GOOGLE_SERVICE_ACCOUNT_JSON.
# Add the service account email to GA4 Property Access Management with Viewer role.
GA4_SERVICE_ACCOUNT_JSON=
GA4_SYNC_DAYS=30


# ─── Google Custom Search (Optional fallback for SERP) ───
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# ─── Open PageRank (Domain Authority) ───
# Get free key at https://openpagerank.com
OPENPAGERANK_API_KEY=

# ─── Google Ads Keyword Planner (Real search volume) ───
# Guide: https://developers.google.com/google-ads/api/docs/first-call/overview
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEV_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=


# ─── Google PageSpeed Insights ───
# Enable at https://console.cloud.google.com → PageSpeed Insights API
PAGESPEED_API_KEY=

# ─── AI Providers ───
# OpenRouter: https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/owl-alpha
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions

# Groq: https://console.groq.com
GROQ_API_KEY=

# ─── Social Poster — Cloudinary (image storage) ───
# https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Social Poster — Meta (Facebook/Instagram) ───
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/social/platforms/meta/callback

# ─── Social Poster — LinkedIn ───
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:4000/social/platforms/linkedin/callback

# ─── Social Poster — YouTube / Google OAuth ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/social/platforms/youtube/callback

# ─── Alerts (Optional) ───
# Discord: https://discord.com/api/webhooks/...
# Telegram: https://api.telegram.org/bot<TOKEN>/sendMessage
ALERT_WEBHOOK_URL=

# Rank check interval in seconds (86400 = once per day)
CHECK_INTERVAL=86400

# ─── Redis (Optional — reserved for future caching) ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
