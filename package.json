{
  "name": "keyword-analyzer",
  "version": "1.0.0",
  "description": "Advanced Keyword Research & Competitor Analysis Tool",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "migrate": "node src/db/migrate.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write 'src/**/*.js' 'tests/**/*.js'",
    "format:check": "prettier --check 'src/**/*.js' 'tests/**/*.js'"
  },
  "keywords": [
    "seo",
    "keyword-research",
    "competitor-analysis",
    "rank-tracking"
  ],
  "author": "Spidy092",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/secure-session": "^8.3.0",
    "@fastify/static": "^10.1.3",
    "@fastify/view": "^10.0.0",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "cloudinary": "^2.9.0",
    "dotenv": "^17.3.1",
    "ejs": "^3.1.10",
    "fastify": "^5.8.1",
    "google-ads-api": "^23.0.0",
    "googleapis": "^173.0.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.1.0",
    "pg": "^8.13.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.0",
    "prettier": "^3.8.4",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
