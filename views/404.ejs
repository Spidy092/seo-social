<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="bg-slate-50 min-h-screen flex items-center justify-center p-6 text-center">
    <div class="max-w-md w-full bg-white rounded-2xl shadow-xl shadow-slate-200/60 overflow-hidden border border-slate-100 p-8">
        <div class="w-20 h-20 bg-indigo-50 rounded-3xl flex items-center justify-center mx-auto mb-6 text-indigo-600 shadow-inner">
            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
        </div>
        <h1 class="text-7xl font-extrabold text-slate-900 tracking-tight mb-2">404</h1>
        <h2 class="text-2xl font-bold text-slate-800 mb-4">Page Not Found</h2>
        <p class="text-slate-500 mb-8 leading-relaxed">
            The page <code class="bg-slate-100 text-slate-700 px-2 py-1 rounded text-sm font-mono break-all"><%= url %></code> could not be found or has been moved.
        </p>
        <a href="/" class="block w-full bg-slate-900 hover:bg-slate-800 text-white font-bold py-4 rounded-xl transition shadow-lg shadow-slate-200 active:scale-[0.98]">
            ← Back to Dashboard
        </a>
    </div>
</body>
</html>
