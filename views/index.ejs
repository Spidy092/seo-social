<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Advanced SEO Keyword Research, Competitor Analysis, and Rank Tracking Tool">
    <title><%= title %></title>
    <link rel="icon" type="image/x-icon" href="/public/favicon.ico">
    <link rel="stylesheet" href="/public/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/public/css/onpage.css">
    <link rel="stylesheet" href="/public/css/technical.css">
    <link rel="stylesheet" href="/public/css/project-dashboard.css">
    <link rel="stylesheet" href="/public/css/page-optimization.css">
    <link rel="stylesheet" href="/public/css/tasks.css">

</head>
<body>
    <!-- Sidebar -->
    <nav class="sidebar">
        <div class="sidebar-header">
            <div class="logo">
                <i class="fas fa-search-dollar"></i>
                <span>Keyword Analyzer</span>
            </div>
        </div>
        <ul class="nav-menu">
            <li class="nav-item active" data-page="dashboard">
                <i class="fas fa-chart-line"></i>
                <span>Dashboard</span>
            </li>
                        <li class="nav-item" data-page="clients">
                <i class="fas fa-briefcase"></i>
                <span>Clients</span>
            </li>
            <li class="nav-item" data-page="project-dashboard">
                <i class="fas fa-tachometer-alt"></i>
                <span>Project Dashboard</span>
            </li>
            <li class="nav-item" data-page="research">
                <i class="fas fa-search"></i>
                <span>Keyword Research</span>
            </li>
            <li class="nav-item" data-page="competitors">
                <i class="fas fa-users"></i>
                <span>Competitors</span>
            </li>
            <li class="nav-item" data-page="analysis">
                <i class="fas fa-balance-scale"></i>
                <span>Compare & Analyze</span>
            </li>
            <li class="nav-item" data-page="tracking">
                <i class="fas fa-chart-bar"></i>
                <span>Rank Tracking</span>
            </li>
            <li class="nav-item" data-page="alerts">
                <i class="fas fa-bell"></i>
                <span>Alerts</span>
                <span class="badge" id="alertBadge">0</span>
            </li>
            <li class="nav-item" data-page="onpage">
                <i class="fas fa-file-invoice"></i>
                <span>On-Page SEO</span>
            </li>
            <li class="nav-item" data-page="page-optimization">
                <i class="fas fa-bullseye"></i>
                <span>Page Optimization</span>
            </li>
            <li class="nav-item" data-page="technical">
                <i class="fas fa-spider"></i>
                <span>Technical SEO</span>
            </li>
            <li class="nav-item" data-page="humanizer">
                <i class="fas fa-pen-nib"></i>
                <span>Content Humanizer</span>
            </li>
            <li class="nav-item" data-page="content-brief">
                <i class="fas fa-file-lines"></i>
                <span>Content Brief</span>
            </li>
            <li class="nav-item" data-page="reports">
                <i class="fas fa-file-pdf"></i>
                <span>Agency Reports</span>
            </li>
            <li class="nav-item" data-page="tasks">
                <i class="fas fa-tasks"></i>
                <span>SEO Tasks</span>
            </li>
            <!-- Social Tools -->
            <li class="nav-item-header" style="padding: 15px 20px 5px; font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600; letter-spacing: 0.5px; opacity: 0.7;">
                Social Poster
            </li>
            <li class="nav-item" data-page="social-upload">
                <i class="fas fa-upload"></i>
                <span>Upload</span>
            </li>
            <li class="nav-item" data-page="social-schedule">
                <i class="fas fa-calendar-alt"></i>
                <span>Schedule</span>
            </li>
            <li class="nav-item" data-page="social-platforms">
                <i class="fas fa-hashtag"></i>
                <span>Platforms</span>
            </li>
            <li class="nav-item" data-page="social-analytics">
                <i class="fas fa-chart-pie"></i>
                <span>Analytics</span>
            </li>
            <li class="nav-item-header" style="padding: 15px 20px 5px; font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600; letter-spacing: 0.5px; opacity: 0.7;">
                Account
            </li>
            <li class="nav-item logout-button">
                <i class="fas fa-sign-out-alt"></i>
                <span>Logout</span>
            </li>
        </ul>
        <div class="sidebar-footer">
            <div class="version">v<%= version %></div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="main-content">
        <!-- Header -->
        <header class="header">
            <div class="header-left">
                <button class="menu-toggle">
                    <i class="fas fa-bars"></i>
                </button>
                <h1 id="pageTitle">Dashboard</h1>
            </div>
            <div class="header-right">
                <div class="search-box">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Search keywords..." id="globalSearch">
                </div>
            </div>
        </header>

        <!-- Pages -->
        <div class="content">
            <!-- Dashboard Page -->
            <div class="page active" id="page-dashboard">
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon blue">
                            <i class="fas fa-key"></i>
                        </div>
                        <div class="stat-info">
                            <h3 id="totalKeywords">0</h3>
                            <p>Keywords Tracked</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon green">
                            <i class="fas fa-trophy"></i>
                        </div>
                        <div class="stat-info">
                            <h3 id="topRankings">0</h3>
                            <p>Top 10 Rankings</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon orange">
                            <i class="fas fa-users"></i>
                        </div>
                        <div class="stat-info">
                            <h3 id="totalCompetitors">0</h3>
                            <p>Competitors Found</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon purple">
                            <i class="fas fa-briefcase"></i>
                        </div>
                        <div class="stat-info">
                            <h3 id="totalClients">0</h3>
                            <p>SEO Clients</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon teal">
                            <i class="fas fa-folder-open"></i>
                        </div>
                        <div class="stat-info">
                            <h3 id="totalProjects">0</h3>
                            <p>SEO Projects</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon red">
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>
                        <div class="stat-info">
                            <h3 id="activeAlerts">0</h3>
                            <p>Active Alerts</p>
                        </div>
                    </div>
                </div>

                <div class="dashboard-grid">
                    <div class="card">
                        <div class="card-header">
                            <h3>Recent Keywords</h3>
                            <a href="#" class="view-all" data-page="research">View All</a>
                        </div>
                        <div class="card-body">
                            <table class="data-table" id="recentKeywordsTable">
                                <thead>
                                    <tr>
                                        <th>Keyword</th>
                                        <th>Volume</th>
                                        <th>Competition</th>
                                        <th>Difficulty</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h3>Recent Alerts</h3>
                            <a href="#" class="view-all" data-page="alerts">View All</a>
                        </div>
                        <div class="card-body">
                            <div class="alerts-list" id="recentAlertsList"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Clients Page -->
            <div class="page" id="page-clients">
                <div class="clients-container">
                    <div class="clients-grid">
                        <div class="card">
                            <div class="card-header">
                                <h3>Client Information</h3>
                                <span class="header-hint">Store client, website, location, competitors, services, and goals</span>
                            </div>
                            <div class="card-body">
                                <input type="hidden" id="clientIdInput">
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>Client Name</label>
                                        <input type="text" id="clientNameInput" placeholder="e.g. Acme Dental Clinic">
                                    </div>
                                    <div class="form-group">
                                        <label>Website URL</label>
                                        <input type="text" id="clientWebsiteInput" placeholder="https://example.com">
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>Industry/Niche</label>
                                        <input type="text" id="clientIndustryInput" placeholder="e.g. Local dental clinic">
                                    </div>
                                    <div class="form-group">
                                        <label>Target Locations</label>
                                        <input type="text" id="clientLocationsInput" placeholder="Bangalore, Whitefield, India">
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>Competitors</label>
                                        <input type="text" id="clientCompetitorsInput" placeholder="competitor1.com, competitor2.com">
                                    </div>
                                    <div class="form-group">
                                        <label>Services/Products</label>
                                        <input type="text" id="clientServicesInput" placeholder="SEO, web design, PPC">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label>Audience</label>
                                    <input type="text" id="clientAudienceInput" placeholder="e.g. homeowners, startup founders, local patients">
                                </div>
                                <div class="form-group">
                                    <label>SEO Goals</label>
                                    <textarea id="clientGoalsInput" placeholder="Rank service pages, grow local leads, build blog topical authority"></textarea>
                                </div>
                                <button class="btn btn-primary" id="saveClientBtn"><i class="fas fa-save"></i> Save Client</button>
                            </div>
                        </div>

                        <div class="card">
                            <div class="card-header">
                                <h3>Client Projects</h3>
                                <span class="header-hint">Create SEO workstreams like Local SEO, Blogs, or Service Pages</span>
                            </div>
                            <div class="card-body">
                                <div class="form-group">
                                    <label>Selected Client</label>
                                    <select id="projectClientSelect"><option value="">Choose a client</option></select>
                                </div>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>Project Name</label>
                                        <input type="text" id="projectNameInput" placeholder="Local SEO campaign">
                                    </div>
                                    <div class="form-group">
                                        <label>Project Type</label>
                                        <select id="projectTypeInput">
                                            <option value="keyword-research">Keyword Research</option>
                                            <option value="local-seo">Local SEO</option>
                                            <option value="content-plan">Content Plan</option>
                                            <option value="competitor-gap">Competitor Gap</option>
                                            <option value="service-pages">Service Pages</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label>Target Location</label>
                                    <input type="text" id="projectLocationInput" placeholder="e.g. Bangalore">
                                </div>
                                <div class="form-group">
                                    <label>Project Goal</label>
                                    <textarea id="projectGoalsInput" placeholder="What should this project achieve?"></textarea>
                                </div>
                                <button class="btn btn-primary" id="saveProjectBtn"><i class="fas fa-folder-plus"></i> Add Project</button>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h3>Saved Clients</h3>
                            <button class="btn btn-sm btn-outline" id="refreshClientsBtn"><i class="fas fa-rotate-right"></i> Refresh</button>
                        </div>
                        <div class="card-body" id="clientsList"></div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h3>Selected Client Projects</h3>
                        </div>
                        <div class="card-body" id="clientProjectsList"><p class="text-muted">Select a client to view projects.</p></div>
                    </div>
                </div>
            </div>

            <!-- Project SEO Dashboard Page -->
            <div class="page" id="page-project-dashboard">
                <div class="project-dashboard-container">
                    <div class="card project-dashboard-header">
                        <div class="card-body">
                            <div class="pdh-top">
                                <div>
                                    <div class="pdh-eyebrow">Project SEO Dashboard</div>
                                    <h2 id="pdProjectName" class="pdh-title">Select a project</h2>
                                    <div class="pdh-sub" id="pdProjectSub"></div>
                                </div>
                                <div class="pdh-controls">
                                    <select id="pdProjectSelect"><option value="">Loading projects…</option></select>
                                    <button class="btn btn-sm btn-outline" id="pdRefreshBtn" title="Refresh dashboard data">
                                        <i class="fas fa-rotate-right"></i> Refresh
                                    </button>
                                </div>
                            </div>
                            <div class="pdh-meta" id="pdProjectMeta"></div>
                        </div>
                    </div>

                    <div id="pdEmptyState" class="card pd-empty">
                        <div class="card-body">
                            <div class="pd-empty-icon"><i class="fas fa-folder-open"></i></div>
                            <h3>Pick a project to see its SEO health</h3>
                            <p>Create a project from the <strong>Clients</strong> page, then come back here for a one-glance view of keywords, ranks, technical health, competitors, alerts, and next actions.</p>
                        </div>
                    </div>

                    <div id="pdDashboardBody" style="display:none">
                        <!-- Summary tiles -->
                        <div class="pd-stats">
                            <div class="pd-stat">
                                <div class="pd-stat-icon blue"><i class="fas fa-key"></i></div>
                                <div class="pd-stat-info">
                                    <h3 id="pdStatKeywords">0</h3>
                                    <p>Target keywords</p>
                                </div>
                            </div>
                            <div class="pd-stat">
                                <div class="pd-stat-icon green"><i class="fas fa-trophy"></i></div>
                                <div class="pd-stat-info">
                                    <h3 id="pdStatTop10">0</h3>
                                    <p>Top 10 rankings</p>
                                </div>
                            </div>
                            <div class="pd-stat">
                                <div class="pd-stat-icon orange"><i class="fas fa-arrow-trend-up"></i></div>
                                <div class="pd-stat-info">
                                    <h3 id="pdStatAvg">—</h3>
                                    <p>Avg. position</p>
                                </div>
                            </div>
                            <div class="pd-stat">
                                <div class="pd-stat-icon purple"><i class="fas fa-spider"></i></div>
                                <div class="pd-stat-info">
                                    <h3 id="pdStatTech">—</h3>
                                    <p>Technical score</p>
                                </div>
                            </div>
                            <div class="pd-stat">
                                <div class="pd-stat-icon teal"><i class="fas fa-bullseye"></i></div>
                                <div class="pd-stat-info">
                                    <h3 id="pdStatVolume">0</h3>
                                    <p>Total search volume</p>
                                </div>
                            </div>
                            <div class="pd-stat">
                                <div class="pd-stat-icon red"><i class="fas fa-bell"></i></div>
                                <div class="pd-stat-info">
                                    <h3 id="pdStatAlerts">0</h3>
                                    <p>Unread alerts</p>
                                </div>
                            </div>
                        </div>

                        <!-- Movement strip -->
                        <div class="card pd-movement">
                            <div class="card-header">
                                <h3>7-day movement</h3>
                                <span class="header-hint">Rank changes for this project's keywords</span>
                            </div>
                            <div class="card-body">
                                <div class="pd-movement-grid">
                                    <div class="pd-move up"><i class="fas fa-arrow-up"></i><strong id="pdMoveUp">0</strong><span>Improved</span></div>
                                    <div class="pd-move down"><i class="fas fa-arrow-down"></i><strong id="pdMoveDown">0</strong><span>Dropped</span></div>
                                    <div class="pd-move new"><i class="fas fa-sparkles"></i><strong id="pdMoveNew">0</strong><span>New</span></div>
                                    <div class="pd-move lost"><i class="fas fa-ghost"></i><strong id="pdMoveLost">0</strong><span>Lost</span></div>
                                    <div class="pd-move gap"><i class="fas fa-circle-question"></i><strong id="pdMoveGap">0</strong><span>Unranked</span></div>
                                </div>
                            </div>
                        </div>

                        <div class="pd-row">
                            <!-- Target keywords table -->
                            <div class="card pd-section-flex">
                                <div class="card-header">
                                    <h3><i class="fas fa-key"></i> Target keywords</h3>
                                    <span class="header-hint">Current rank, change, and on-page intent</span>
                                </div>
                                <div class="card-body pd-table-wrap">
                                    <table class="data-table" id="pdKeywordsTable">
                                        <thead>
                                            <tr>
                                                <th>Keyword</th>
                                                <th>Intent</th>
                                                <th>Volume</th>
                                                <th>Difficulty</th>
                                                <th>Current rank</th>
                                                <th>Change</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Top competitors -->
                            <div class="card pd-section-fixed">
                                <div class="card-header">
                                    <h3><i class="fas fa-users"></i> Top competitors</h3>
                                    <span class="header-hint">Domains outranking you on the most project keywords</span>
                                </div>
                                <div class="card-body" id="pdCompetitorsList"></div>
                            </div>
                        </div>

                        <div class="pd-row">
                            <!-- Technical health -->
                            <div class="card pd-section-fixed">
                                <div class="card-header">
                                    <h3><i class="fas fa-spider"></i> Technical health</h3>
                                    <span class="header-hint">Latest crawl for the client's website</span>
                                </div>
                                <div class="card-body" id="pdTechnicalBlock"></div>
                            </div>

                            <!-- Content gaps -->
                            <div class="card pd-section-flex">
                                <div class="card-header">
                                    <h3><i class="fas fa-puzzle-piece"></i> Content gaps</h3>
                                    <span class="header-hint">Priority keywords that are unranked or missing</span>
                                </div>
                                <div class="card-body" id="pdContentGaps"></div>
                            </div>
                        </div>

                        <div class="pd-row">
                            <!-- Alerts -->
                            <div class="card pd-section-flex">
                                <div class="card-header">
                                    <h3><i class="fas fa-bell"></i> Recent alerts</h3>
                                    <span class="header-hint">Rank and indexing events for project keywords</span>
                                </div>
                                <div class="card-body" id="pdAlertsList"></div>
                            </div>

                            <!-- Recommended actions -->
                            <div class="card pd-section-fixed pd-actions-card">
                                <div class="card-header">
                                    <h3><i class="fas fa-flag-checkered"></i> Next recommended actions</h3>
                                    <span class="header-hint">Derived from current rank, tech, and gap data</span>
                                </div>
                                <div class="card-body" id="pdActionsList"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Keyword Research Page -->
            <div class="page" id="page-research">
                <div class="research-container">
                    <div class="research-form card">
                        <h3>🔍 Advanced Keyword Research</h3>
                        <div class="form-group">
                            <label>Enter Keyword</label>
                            <input type="text" id="keywordInput" placeholder="e.g., web design company in bangalore">
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Country</label>
                                <select id="countryInput">
                                    <option value="India">India</option>
                                    <option value="United States">United States</option>
                                    <option value="United Kingdom">United Kingdom</option>
                                    <option value="Canada">Canada</option>
                                    <option value="Australia">Australia</option>
                                    <option value="Germany">Germany</option>
                                    <option value="UAE">UAE</option>
                                    <option value="Singapore">Singapore</option>
                                </select>
                            </div>
                            <div class="form-group" id="cityGroup">
                                <label>City / Location</label>
                                <select id="cityInput">
                                    <option value="">All India</option>
                                    <option value="Bangalore">Bangalore</option>
                                    <option value="Mumbai">Mumbai</option>
                                    <option value="Delhi">Delhi</option>
                                    <option value="Chennai">Chennai</option>
                                    <option value="Hyderabad">Hyderabad</option>
                                    <option value="Pune">Pune</option>
                                    <option value="Kolkata">Kolkata</option>
                                    <option value="Ahmedabad">Ahmedabad</option>
                                    <option value="Jaipur">Jaipur</option>
                                    <option value="Kochi">Kochi</option>
                                </select>
                            </div>
                        </div>
                        
                        <div class="form-group" id="areaGroup" style="display: none;">
                            <label>Specific Area / Locality</label>
                            <select id="areaInput">
                                    <option value="">All Bangalore</option>
                            </select>
                        </div>

                                                <div class="form-group">
                            <label>Save research to project</label>
                            <select id="researchProjectSelect">
                                <option value="">Do not attach to project</option>
                            </select>
                        </div>

                        <div class="checkbox-row">
                            <label class="checkbox-label">
                                <input type="checkbox" id="includeIntent" checked>
                                <span>Intent Analysis</span>
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" id="includeSerpFeatures" checked>
                                <span>SERP Features</span>
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" id="includeContentGap" checked>
                                <span>Content Gap Analysis</span>
                            </label>
                        </div>
                        
                        <button class="btn btn-primary" id="researchBtn" style="width: 200px; justify-content: center; height: 50px; font-weight: 600;">
                            <i class="fas fa-search"></i> Research Now
                        </button>
                    </div>

                    <div class="research-results" id="researchResults" style="display: none;">
                        <!-- Advanced Metrics -->
                        <div class="keyword-metrics card">
                            <h3>📊 Keyword Overview</h3>
                            <div class="metrics-grid">
                                <div class="metric-card">
                                    <div class="metric-header">
                                        <span class="metric-label">Search Volume</span>
                                        <span class="metric-icon"><i class="fas fa-search"></i></span>
                                    </div>
                                    <div class="metric-value" id="searchVolume">-</div>
                                </div>
                                <div class="metric-card">
                                    <div class="metric-header">
                                        <span class="metric-label">Opportunity Score</span>
                                        <span class="metric-icon"><i class="fas fa-star"></i></span>
                                    </div>
                                    <div class="metric-value" id="opportunityScore">-</div>
                                </div>
                                <div class="metric-card">
                                    <div class="metric-header">
                                        <span class="metric-label">Competition</span>
                                        <span class="metric-icon"><i class="fas fa-chart-bar"></i></span>
                                    </div>
                                    <div class="metric-value" id="competition">-</div>
                                </div>
                                <div class="metric-card">
                                    <div class="metric-header">
                                        <span class="metric-label">Difficulty</span>
                                        <span class="metric-icon"><i class="fas fa-tachometer-alt"></i></span>
                                    </div>
                                    <div class="metric-value" id="difficulty">-</div>
                                </div>
                            </div>
                        </div>

                        <!-- Intent Analysis -->
