                            <div>
                                <div style="font-size: 12px; color: var(--text-muted); font-weight: 500;">Completed</div>
                                <div id="statCompletedTasks" style="font-size: 1.5rem; font-weight: 700; color: #10b981;">0</div>
                            </div>
                        </div>
                    </div>

                    <!-- Kanban Board columns -->
                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; align-items: start;" class="tasks-board-grid">
                        
                        <!-- Column: To Do -->
                        <div style="background: rgba(249, 250, 251, 0.5); border: 1px solid var(--border); border-radius: 16px; padding: 16px; min-height: 500px; display: flex; flex-direction: column; gap: 14px;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span style="width: 8px; height: 8px; background: #6b7280; border-radius: 50%;"></span>
                                    <h4 style="margin: 0; font-size: 0.95rem; font-weight: 700; color: var(--text);">To Do</h4>
                                </div>
                                <span id="countTodo" style="font-size: 11px; font-weight: 600; background: var(--border); padding: 2px 8px; border-radius: 12px; color: var(--text-muted);">0</span>
                            </div>
                            <div id="columnTodo" style="display: flex; flex-direction: column; gap: 12px; flex-grow: 1;" class="task-column-container" data-status="todo">
                                <!-- Tasks injected here -->
                            </div>
                        </div>

                        <!-- Column: In Progress -->
                        <div style="background: rgba(249, 250, 251, 0.5); border: 1px solid var(--border); border-radius: 16px; padding: 16px; min-height: 500px; display: flex; flex-direction: column; gap: 14px;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span style="width: 8px; height: 8px; background: #f59e0b; border-radius: 50%;"></span>
                                    <h4 style="margin: 0; font-size: 0.95rem; font-weight: 700; color: var(--text);">In Progress</h4>
                                </div>
                                <span id="countInProgress" style="font-size: 11px; font-weight: 600; background: rgba(245, 158, 11, 0.15); padding: 2px 8px; border-radius: 12px; color: #d97706;">0</span>
                            </div>
                            <div id="columnInProgress" style="display: flex; flex-direction: column; gap: 12px; flex-grow: 1;" class="task-column-container" data-status="in_progress">
                                <!-- Tasks injected here -->
                            </div>
                        </div>

                        <!-- Column: Completed -->
                        <div style="background: rgba(249, 250, 251, 0.5); border: 1px solid var(--border); border-radius: 16px; padding: 16px; min-height: 500px; display: flex; flex-direction: column; gap: 14px;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span style="width: 8px; height: 8px; background: #10b981; border-radius: 50%;"></span>
                                    <h4 style="margin: 0; font-size: 0.95rem; font-weight: 700; color: var(--text);">Completed</h4>
                                </div>
                                <span id="countCompleted" style="font-size: 11px; font-weight: 600; background: rgba(16, 185, 129, 0.15); padding: 2px 8px; border-radius: 12px; color: #059669;">0</span>
                            </div>
                            <div id="columnCompleted" style="display: flex; flex-direction: column; gap: 12px; flex-grow: 1;" class="task-column-container" data-status="completed">
                                <!-- Tasks injected here -->
                            </div>
                        </div>

                    </div>

                </div>
            </div>

            <!-- Task Creation / Editing Modal -->
            <div class="modal" id="taskModal">
                <div class="modal-content" style="max-width: 500px;">
                    <div class="modal-header">
                        <h3 id="taskModalTitle">➕ Add Custom Task</h3>
                        <button class="modal-close" onclick="closeTaskModal()">&times;</button>
                    </div>
                    <div class="modal-body">
                        <form id="taskForm" onsubmit="saveTask(event)">
                            <input type="hidden" id="taskFormId">
                            <div class="form-group">
                                <label style="font-size: 12px; font-weight: 600;">Task Title</label>
                                <input type="text" id="taskFormTitle" placeholder="e.g. Add FAQ schema to homepage" style="width: 100%;" required>
                            </div>
                            <div class="form-group">
                                <label style="font-size: 12px; font-weight: 600;">Description</label>
                                <textarea id="taskFormDesc" placeholder="Explain what to do, target URLs, LSI keywords to add..." style="width: 100%; min-height: 80px;"></textarea>
                            </div>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                                <div class="form-group">
                                    <label style="font-size: 12px; font-weight: 600;">Category</label>
                                    <select id="taskFormCategory" style="width: 100%;">
                                        <option value="on-page">On-Page SEO</option>
                                        <option value="technical">Technical SEO</option>
                                        <option value="content">Content Strategy</option>
                                        <option value="link-building">Link Building</option>
                                        <option value="local-seo">Local SEO</option>
                                        <option value="general">General</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label style="font-size: 12px; font-weight: 600;">Priority</label>
                                    <select id="taskFormPriority" style="width: 100%;">
                                        <option value="critical">🚨 Critical</option>
                                        <option value="high">🟠 High</option>
                                        <option value="medium" selected>🟡 Medium</option>
                                        <option value="low">🟢 Low</option>
                                    </select>
                                </div>
                            </div>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                                <div class="form-group">
                                    <label style="font-size: 12px; font-weight: 600;">Impact</label>
                                    <select id="taskFormImpact" style="width: 100%;">
                                        <option value="high">High</option>
                                        <option value="medium" selected>Medium</option>
                                        <option value="low">Low</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label style="font-size: 12px; font-weight: 600;">Effort</label>
                                    <select id="taskFormEffort" style="width: 100%;">
                                        <option value="high">High</option>
                                        <option value="medium" selected>Medium</option>
                                        <option value="low">Low</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group">
                                <label style="font-size: 12px; font-weight: 600;">Status</label>
                                <select id="taskFormStatus" style="width: 100%;">
                                    <option value="todo" selected>To Do</option>
                                    <option value="in_progress">In Progress</option>
                                    <option value="completed">Completed</option>
                                </select>
                            </div>
                            <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 20px;">
                                <button type="button" class="btn btn-outline" onclick="closeTaskModal()">Cancel</button>
                                <button type="submit" class="btn btn-primary">Save Task</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- ─── Reports Page ─── -->
            <div class="page" id="page-reports">
                <div style="max-width: 1100px; margin: 0 auto; padding: 0 4px;">

                    <!-- Header -->
                    <div style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); border-radius: 16px; padding: 32px 36px; margin-bottom: 28px; color: white; position: relative; overflow: hidden;">
                        <div style="position:absolute;top:-40px;right:-40px;width:160px;height:160px;border-radius:50%;background:rgba(255,255,255,0.07);"></div>
                        <div style="display:flex;align-items:center;gap:14px;margin-bottom:10px;">
                            <div style="width:48px;height:48px;background:rgba(255,255,255,0.15);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;">📊</div>
                            <div>
                                <h2 style="font-size:1.4rem;font-weight:800;margin:0;">Agency-Ready SEO Reports</h2>
                                <p style="opacity:0.85;font-size:13px;margin:0;">Generate professional PDF/HTML reports for your clients in seconds</p>
                            </div>
                        </div>
                        <div style="display:flex;gap:20px;flex-wrap:wrap;margin-top:14px;font-size:12px;opacity:0.8;">
                            <span>📄 Monthly SEO Report</span>
                            <span>📈 Keyword Movement</span>
                            <span>🔧 Technical Fixes</span>
                            <span>✍️ Content Recommendations</span>
                            <span>⚔️ Competitor Changes</span>
                            <span>🗓️ Next Month Plan</span>
                        </div>
                    </div>

                    <!-- Report Builder -->
                    <div style="display:grid;grid-template-columns:400px 1fr;gap:24px;align-items:start;">

                        <!-- Left: Form -->
                        <div class="card" style="position:sticky;top:20px;">
                            <div class="card-header" style="border-bottom:1px solid var(--border);padding-bottom:14px;margin-bottom:20px;">
                                <h3 style="margin:0;font-size:1rem;">⚙️ Report Builder</h3>
                            </div>
                            <div class="card-body" style="padding:0;">
                                <div class="form-group">
                                    <label style="font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;">Report Title</label>
                                    <input type="text" id="reportTitle" placeholder="Monthly SEO Report – June 2025" style="width:100%;">
                                </div>
                                <div class="form-group">
                                    <label style="font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;">Client</label>
                                    <select id="reportClientSelect" style="width:100%;">
                                        <option value="">No specific client (by domain)</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label style="font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;">Domain to Track</label>
                                    <input type="text" id="reportDomain" placeholder="yourdomain.com" style="width:100%;">
                                </div>
                                <div class="form-group">
                                    <label style="font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;">Report Period</label>
                                    <select id="reportPeriod" style="width:100%;">
                                        <option value="30">Last 30 days</option>
                                        <option value="60">Last 60 days</option>
                                        <option value="90">Last 90 days (Quarter)</option>
                                        <option value="7">Last 7 days</option>
                                    </select>
                                </div>
                                <button class="btn btn-primary" id="generateReportBtn" style="width:100%;justify-content:center;height:48px;font-size:0.95rem;font-weight:700;margin-top:8px;">
                                    <i class="fas fa-magic"></i> Generate Report
                                </button>
                                <div id="reportGenerating" style="display:none;text-align:center;padding:16px;color:var(--text-muted);font-size:13px;">
                                    <div style="display:inline-block;width:20px;height:20px;border:2px solid var(--brand);border-top-color:transparent;border-radius:50%;animation:spin 0.8s linear infinite;margin-right:8px;"></div>
                                    Generating report with AI analysis...
                                </div>
                            </div>
                        </div>

                        <!-- Right: Preview & Saved Reports -->
                        <div>
                            <!-- Live Preview -->
                            <div class="card" id="reportPreviewCard" style="display:none;margin-bottom:20px;">
                                <div class="card-header" style="border-bottom:1px solid var(--border);padding-bottom:14px;margin-bottom:20px;display:flex;align-items:center;justify-content:space-between;">
                                    <h3 style="margin:0;font-size:1rem;">📋 Report Preview</h3>
                                    <div style="display:flex;gap:8px;">
                                        <button class="btn btn-sm btn-outline" id="saveReportBtn"><i class="fas fa-save"></i> Save</button>
                                        <button class="btn btn-sm btn-primary" id="openReportBtn"><i class="fas fa-external-link-alt"></i> Open Full Report</button>
                                    </div>
                                </div>
                                <div id="reportPreviewContent"></div>
                            </div>

                            <!-- Saved Reports -->
                            <div class="card">
                                <div class="card-header" style="border-bottom:1px solid var(--border);padding-bottom:14px;margin-bottom:20px;display:flex;align-items:center;justify-content:space-between;">
                                    <h3 style="margin:0;font-size:1rem;">🗂️ Saved Reports</h3>
                                    <button class="btn btn-sm btn-outline" onclick="loadSavedReports()"><i class="fas fa-rotate-right"></i> Refresh</button>
                                </div>
                                <div id="savedReportsList">
                                    <p style="color:var(--text-muted);font-size:13px;text-align:center;padding:20px;">No saved reports yet. Generate your first report above.</p>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </main>

    <!-- Competitor Analysis Modal -->
    <div class="modal" id="competitorAnalysisModal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>📊 Page Analysis</h3>
                <button class="modal-close">&times;</button>
            </div>
            <div class="modal-body" id="competitorAnalysisContent"></div>
        </div>
    </div>

    <!-- Loading Overlay -->
    <div class="loading-overlay" id="loadingOverlay">
        <div class="spinner"></div>
        <p id="loadingText">Analyzing...</p>
    </div>

    <!-- Toast Notifications -->
    <div class="toast-container" id="toastContainer"></div>

    <script src="/public/js/app.js"></script>
    <script src="/public/js/onpage.js"></script>
    <script src="/public/js/technical.js"></script>
    <script src="/public/js/contentBrief.js"></script>
    <script src="/public/js/project-dashboard.js"></script>
    <script src="/public/js/page-optimization.js"></script>
    <script src="/public/js/reports.js"></script>
    <script src="/public/js/tasks.js"></script>

</body>
</html>
