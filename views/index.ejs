<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Advanced SEO Keyword Research, Competitor Analysis, and Rank Tracking Tool">
    <title><%= title %></title>
    <link rel="icon" type="image/x-icon" href="/public/favicon.ico">
    <link rel="stylesheet" href="/public/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/public/css/onpage.css">
    <link rel="stylesheet" href="/public/css/technical.css">
    <link rel="stylesheet" href="/public/css/project-dashboard.css">
    <link rel="stylesheet" href="/public/css/page-optimization.css">
    <link rel="stylesheet" href="/public/css/tasks.css">
    <link rel="stylesheet" href="/public/css/sitemap.css">

</head>
<body>
    <!-- Sidebar -->
    <nav class="sidebar">
        <div class="sidebar-header">
            <div class="logo">
                <i class="fas fa-search-dollar"></i>
                <span class="logo-text">Keyword Analyzer</span>
            </div>
            <button class="sidebar-collapse-btn" id="sidebarCollapseBtn" title="Collapse sidebar">
                <i class="fas fa-angles-left"></i>
            </button>
        </div>
        <ul class="nav-menu">
            <!-- Overview -->
            <li class="nav-group">
                <div class="nav-group-header" data-group="overview">
                    <span class="nav-group-label">Overview</span>
                    <i class="fas fa-chevron-down nav-group-arrow"></i>
                </div>
                <ul class="nav-group-items">
                    <li class="nav-item active" data-page="dashboard" data-tooltip="Dashboard">
                        <i class="fas fa-chart-line"></i>
                        <span>Dashboard</span>
                    </li>
                    <li class="nav-item" data-page="clients" data-tooltip="Clients">
                        <i class="fas fa-briefcase"></i>
                        <span>Clients</span>
                    </li>
                    <li class="nav-item" data-page="project-dashboard" data-tooltip="Project Dashboard">
                        <i class="fas fa-tachometer-alt"></i>
                        <span>Project Dashboard</span>
                    </li>
                </ul>
            </li>
            <!-- Research & Analysis -->
            <li class="nav-group">
                <div class="nav-group-header" data-group="research">
                    <span class="nav-group-label">Research & Analysis</span>
                    <i class="fas fa-chevron-down nav-group-arrow"></i>
                </div>
                <ul class="nav-group-items">
                    <li class="nav-item" data-page="research" data-tooltip="Keyword Research">
                        <i class="fas fa-search"></i>
                        <span>Keyword Research</span>
                    </li>
                    <li class="nav-item" data-page="competitors" data-tooltip="Competitors">
                        <i class="fas fa-users"></i>
                        <span>Competitors</span>
                    </li>
                    <li class="nav-item" data-page="analysis" data-tooltip="Compare & Analyze">
                        <i class="fas fa-balance-scale"></i>
                        <span>Compare & Analyze</span>
                    </li>
                    <li class="nav-item" data-page="tracking" data-tooltip="Rank Tracking">
                        <i class="fas fa-chart-bar"></i>
                        <span>Rank Tracking</span>
                    </li>
                    <li class="nav-item" data-page="gsc" data-tooltip="Search Console">
                        <i class="fas fa-chart-column"></i>
                        <span>Search Console</span>
                    </li>
                    <li class="nav-item" data-page="seo-performance" data-tooltip="SEO Performance">
                        <i class="fas fa-chart-line"></i>
                        <span>SEO Performance</span>
                    </li>
                    <li class="nav-item" data-page="search-visibility" data-tooltip="Search Visibility">
                        <i class="fas fa-magnifying-glass-chart"></i>
                        <span>Search Visibility</span>
                    </li>
                    <li class="nav-item" data-page="alerts" data-tooltip="Alerts">
                        <i class="fas fa-bell"></i>
                        <span>Alerts</span>
                        <span class="badge" id="alertBadge">0</span>
                    </li>
                </ul>
            </li>
            <!-- Audit -->
            <li class="nav-group">
                <div class="nav-group-header" data-group="audit">
                    <span class="nav-group-label">Audit</span>
                    <i class="fas fa-chevron-down nav-group-arrow"></i>
                </div>
                <ul class="nav-group-items">
                    <li class="nav-item" data-page="onpage" data-tooltip="On-Page SEO">
                        <i class="fas fa-file-invoice"></i>
                        <span>On-Page SEO</span>
                    </li>
                    <li class="nav-item" data-page="page-optimization" data-tooltip="Page Optimization">
                        <i class="fas fa-bullseye"></i>
                        <span>Page Optimization</span>
                    </li>
                    <li class="nav-item" data-page="page-speed" data-tooltip="PageSpeed">
                        <i class="fas fa-bolt"></i>
                        <span>PageSpeed</span>
                    </li>
                    <li class="nav-item" data-page="technical" data-tooltip="Technical SEO">
                        <i class="fas fa-spider"></i>
                        <span>Technical SEO</span>
                    </li>
                    <li class="nav-item" data-page="sitemap" data-tooltip="Sitemap Generator">
                        <i class="fas fa-sitemap"></i>
                        <span>Sitemap Generator</span>
                    </li>
                </ul>
            </li>
            <!-- Content -->
            <li class="nav-group">
                <div class="nav-group-header" data-group="content">
                    <span class="nav-group-label">Content</span>
                    <i class="fas fa-chevron-down nav-group-arrow"></i>
                </div>
                <ul class="nav-group-items">
                    <li class="nav-item" data-page="humanizer" data-tooltip="Content Humanizer">
                        <i class="fas fa-pen-nib"></i>
                        <span>Content Humanizer</span>
                    </li>
                    <li class="nav-item" data-page="content-brief" data-tooltip="Content Brief">
                        <i class="fas fa-file-lines"></i>
                        <span>Content Brief</span>
                    </li>
                    <li class="nav-item" data-page="reports" data-tooltip="Agency Reports">
                        <i class="fas fa-file-pdf"></i>
                        <span>Agency Reports</span>
                    </li>
                    <li class="nav-item" data-page="tasks" data-tooltip="SEO Tasks">
                        <i class="fas fa-tasks"></i>
                        <span>SEO Tasks</span>
                    </li>
                </ul>
            </li>
            <!-- Agency Settings -->
            <li class="nav-group">
                <div class="nav-group-header" data-group="agency">
                    <span class="nav-group-label">Agency</span>
                    <i class="fas fa-chevron-down nav-group-arrow"></i>
                </div>
                <ul class="nav-group-items">
                    <li class="nav-item" data-page="agency-settings" data-tooltip="Agency Settings">
                        <i class="fas fa-building"></i>
                        <span>Agency Settings</span>
                    </li>
                    <li class="nav-item" data-page="agency-members" data-tooltip="Team Members">
                        <i class="fas fa-user-group"></i>
                        <span>Team Members</span>
                    </li>
                </ul>
            </li>
            <!-- Social Poster -->
            <li class="nav-group">
                <div class="nav-group-header" data-group="social">
                    <span class="nav-group-label">Social Poster</span>
                    <i class="fas fa-chevron-down nav-group-arrow"></i>
                </div>
                <ul class="nav-group-items">
                    <li class="nav-item" data-page="social-upload" data-tooltip="Upload">
                        <i class="fas fa-upload"></i>
                        <span>Upload</span>
                    </li>
                    <li class="nav-item" data-page="social-schedule" data-tooltip="Schedule">
                        <i class="fas fa-calendar-alt"></i>
                        <span>Schedule</span>
                    </li>
                    <li class="nav-item" data-page="social-platforms" data-tooltip="Platforms">
                        <i class="fas fa-hashtag"></i>
                        <span>Platforms</span>
                    </li>
                    <li class="nav-item" data-page="social-analytics" data-tooltip="Analytics">
                        <i class="fas fa-chart-pie"></i>
                        <span>Analytics</span>
                    </li>
                </ul>
            </li>
        </ul>
        <div class="sidebar-footer">
            <div class="version">v<%= version %></div>
            <div class="nav-item logout-button">
                <i class="fas fa-sign-out-alt"></i>
                <span class="logo-text">Logout</span>
            </div>
        </div>
    </nav>

    <!-- Command Palette Modal -->
    <div class="command-palette-overlay" id="commandPalette">
        <div class="command-palette">
            <div class="command-palette-input-wrap">
                <i class="fas fa-search"></i>
                <input type="text" id="commandPaletteInput" placeholder="Search pages, keywords, commands..." autocomplete="off">
                <kbd>ESC</kbd>
            </div>
            <div class="command-palette-results" id="commandPaletteResults"></div>
            <div class="command-palette-footer">
                <span><kbd>&uarr;</kbd><kbd>&darr;</kbd> navigate</span>
                <span><kbd>Enter</kbd> select</span>
                <span><kbd>Esc</kbd> close</span>
            </div>
        </div>
    </div>

    <!-- Sidebar Overlay for Mobile -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Back to Top Button -->
    <button class="back-to-top" id="backToTop" title="Back to top">
        <i class="fas fa-arrow-up"></i>
    </button>

    <!-- Main Content -->
    <main class="main-content">
        <!-- Header -->
        <header class="header">
            <div class="header-left">
                <button class="menu-toggle" id="menuToggle">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="header-title-area">
                    <nav class="breadcrumbs" id="breadcrumbs">
                        <span class="breadcrumb-item"><i class="fas fa-home"></i></span>
                    </nav>
                    <h1 id="pageTitle">Dashboard</h1>
                </div>
            </div>
            <div class="header-right">
                <button class="header-action-btn command-palette-trigger" id="commandPaletteTrigger" title="Search (Ctrl+K)">
                    <i class="fas fa-search"></i>
                    <span class="search-hint">Search...</span>
                    <kbd>Ctrl+K</kbd>
                </button>
                <button class="header-action-btn" id="themeToggle" title="Toggle dark mode">
                    <i class="fas fa-moon"></i>
                </button>
            </div>
        </header>

        <!-- Pages -->
        <div class="content">
            <!-- Dashboard Page -->
            <div class="page active" id="page-dashboard">
                <!-- Quick Actions -->
                <div class="quick-actions">
                    <button class="quick-action-btn" data-page="research">
                        <i class="fas fa-search blue"></i>
                        <span>New Research</span>
                    </button>
                    <button class="quick-action-btn" data-page="onpage">
                        <i class="fas fa-spider green"></i>
                        <span>Run Audit</span>
                    </button>
                    <button class="quick-action-btn" data-page="reports">
                        <i class="fas fa-file-pdf purple"></i>
                        <span>Generate Report</span>
                    </button>
                    <button class="quick-action-btn" data-page="tasks">
                        <i class="fas fa-tasks blue"></i>
                        <span>View Tasks</span>
                    </button>
                </div>

                <!-- Onboarding Checklist (shown until dismissed) -->
                <div id="onboardingChecklist" class="card" style="display:none; margin-bottom: 20px; border-left: 4px solid #6366f1;">
                    <div class="card-body" style="padding: 20px;">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
                            <div style="display:flex; align-items:center; gap:10px;">
                                <span style="font-size:1.3rem;">🚀</span>
                                <h3 style="margin:0; font-size:1rem; font-weight:700;">Welcome! Here's how to get started</h3>
                            </div>
                            <button id="dismissOnboarding" style="background:none;border:none;color:#94a3b8;cursor:pointer;font-size:1.2rem;padding:4px;" title="Dismiss">&times;</button>
                        </div>
                        <div id="checklistItems" style="display:flex;flex-direction:column;gap:10px;"></div>
                    </div>
                </div>

                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon blue">
                            <i class="fas fa-key"></i>
                        </div>
                        <div class="stat-info">
                            <h3 id="totalKeywords">0</h3>
                            <p>Keywords Tracked</p>
                            <div class="stat-trend neutral" id="keywordsTrend"></div>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon green">
                            <i class="fas fa-trophy"></i>
                        </div>
                        <div class="stat-info">
                            <h3 id="topRankings">0</h3>
                            <p>Top 10 Rankings</p>
                            <div class="stat-trend neutral" id="rankingsTrend"></div>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon orange">
                            <i class="fas fa-users"></i>
                        </div>
                        <div class="stat-info">
                            <h3 id="totalCompetitors">0</h3>
                            <p>Competitors Found</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon purple">
                            <i class="fas fa-briefcase"></i>
                        </div>
                        <div class="stat-info">
                            <h3 id="totalClients">0</h3>
                            <p>SEO Clients</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon teal">
                            <i class="fas fa-folder-open"></i>
                        </div>
                        <div class="stat-info">
                            <h3 id="totalProjects">0</h3>
                            <p>SEO Projects</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon red">
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>
                        <div class="stat-info">
                            <h3 id="activeAlerts">0</h3>
                            <p>Active Alerts</p>
                        </div>
                    </div>
                </div>

                <div class="dashboard-grid">
                    <div class="card">
                        <div class="card-header">
                            <h3>Recent Keywords</h3>
                            <a href="#" class="view-all" data-page="research">View All</a>
                        </div>
                        <div class="card-body">
                            <table class="data-table" id="recentKeywordsTable">
                                <thead>
                                    <tr>
                                        <th>Keyword</th>
                                        <th>Volume</th>
                                        <th>Competition</th>
                                        <th>Difficulty</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h3>Recent Alerts</h3>
                            <a href="#" class="view-all" data-page="alerts">View All</a>
                        </div>
                        <div class="card-body">
                            <div class="alerts-list" id="recentAlertsList"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Clients Page -->
            <div class="page" id="page-clients">
                <div class="clients-container">
                    <div class="clients-grid">
                        <div class="card">
                            <div class="card-header">
                                <h3>Client Information</h3>
                                <span class="header-hint">Store client, website, location, competitors, services, and goals</span>
                            </div>
                            <div class="card-body">
                                <input type="hidden" id="clientIdInput">
                                <!-- Wizard Steps Indicator -->
                                <div class="wizard-steps">
                                    <div class="wizard-step active" data-step="1">
                                        <span class="wizard-step-num">1</span>
                                        <span class="wizard-step-label">Basic Info</span>
                                    </div>
                                    <div class="wizard-step-line"></div>
                                    <div class="wizard-step" data-step="2">
                                        <span class="wizard-step-num">2</span>
                                        <span class="wizard-step-label">Market</span>
                                    </div>
                                    <div class="wizard-step-line"></div>
                                    <div class="wizard-step" data-step="3">
                                        <span class="wizard-step-num">3</span>
                                        <span class="wizard-step-label">Goals</span>
                                    </div>
                                </div>

                                <!-- Step 1: Basic Info -->
                                <div class="wizard-panel active" data-panel="1">
                                    <div class="form-row">
                                        <div class="form-group">
                                            <label>Client Name <span class="required">*</span></label>
                                            <input type="text" id="clientNameInput" placeholder="e.g. Acme Dental Clinic" required>
                                            <div class="field-error"><i class="fas fa-exclamation-circle"></i> <span></span></div>
                                        </div>
                                        <div class="form-group">
                                            <label>Website URL <span class="required">*</span></label>
                                            <input type="text" id="clientWebsiteInput" placeholder="https://example.com" required>
                                            <div class="field-error"><i class="fas fa-exclamation-circle"></i> <span></span></div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label>Industry/Niche</label>
                                        <input type="text" id="clientIndustryInput" placeholder="e.g. Local dental clinic">
                                    </div>
                                    <div class="wizard-nav">
                                        <span></span>
                                        <button class="btn btn-primary wizard-next" data-next="2">Next <i class="fas fa-arrow-right"></i></button>
                                    </div>
                                </div>

                                <!-- Step 2: Market -->
                                <div class="wizard-panel" data-panel="2">
                                    <div class="form-group">
                                        <label>Target Locations</label>
                                        <input type="text" id="clientLocationsInput" placeholder="Bangalore, Whitefield, India">
                                    </div>
                                    <div class="form-group">
                                        <label>Competitors</label>
                                        <input type="text" id="clientCompetitorsInput" placeholder="competitor1.com, competitor2.com">
                                    </div>
                                    <div class="form-group">
                                        <label>Services/Products</label>
                                        <input type="text" id="clientServicesInput" placeholder="SEO, web design, PPC">
                                    </div>
                                    <div class="wizard-nav">
                                        <button class="btn btn-outline wizard-prev" data-prev="1"><i class="fas fa-arrow-left"></i> Back</button>
                                        <button class="btn btn-primary wizard-next" data-next="3">Next <i class="fas fa-arrow-right"></i></button>
                                    </div>
                                </div>

                                <!-- Step 3: Goals -->
                                <div class="wizard-panel" data-panel="3">
                                    <div class="form-group">
                                        <label>Audience</label>
                                        <input type="text" id="clientAudienceInput" placeholder="e.g. homeowners, startup founders, local patients">
                                    </div>
                                    <div class="form-group">
                                        <label>SEO Goals</label>
                                        <textarea id="clientGoalsInput" placeholder="Rank service pages, grow local leads, build blog topical authority"></textarea>
                                    </div>
                                    <div class="wizard-nav">
                                        <button class="btn btn-outline wizard-prev" data-prev="2"><i class="fas fa-arrow-left"></i> Back</button>
                                        <button class="btn btn-primary" id="saveClientBtn"><i class="fas fa-save"></i> Save Client</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card">
                            <div class="card-header">
                                <h3>Client Projects</h3>
                                <span class="header-hint">Create SEO workstreams like Local SEO, Blogs, or Service Pages</span>
                            </div>
                            <div class="card-body">
                                <div class="form-group">
                                    <label>Selected Client</label>
                                    <select id="projectClientSelect"><option value="">Choose a client</option></select>
                                </div>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>Project Name</label>
                                        <input type="text" id="projectNameInput" placeholder="Local SEO campaign">
                                    </div>
                                    <div class="form-group">
                                        <label>Project Type</label>
                                        <select id="projectTypeInput">
                                            <option value="keyword-research">Keyword Research</option>
                                            <option value="local-seo">Local SEO</option>
                                            <option value="content-plan">Content Plan</option>
                                            <option value="competitor-gap">Competitor Gap</option>
                                            <option value="service-pages">Service Pages</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label>Target Location</label>
                                    <input type="text" id="projectLocationInput" placeholder="e.g. Bangalore">
                                </div>
                                <div class="form-group">
                                    <label>Project Goal</label>
                                    <textarea id="projectGoalsInput" placeholder="What should this project achieve?"></textarea>
                                </div>
                                <button class="btn btn-primary" id="saveProjectBtn"><i class="fas fa-folder-plus"></i> Add Project</button>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h3>Saved Clients</h3>
                            <button class="btn btn-sm btn-outline" id="refreshClientsBtn"><i class="fas fa-rotate-right"></i> Refresh</button>
                        </div>
                        <div class="card-body" id="clientsList"></div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h3>Selected Client Projects</h3>
                        </div>
                        <div class="card-body" id="clientProjectsList"><p class="text-muted">Select a client to view projects.</p></div>
                    </div>
                </div>
            </div>

            <!-- Project SEO Dashboard Page -->
            <div class="page" id="page-project-dashboard">
                <div class="project-dashboard-container">
                    <div class="card project-dashboard-header">
                        <div class="card-body">
                            <div class="pdh-top">
                                <div>
                                    <div class="pdh-eyebrow">Project SEO Dashboard</div>
                                    <h2 id="pdProjectName" class="pdh-title">Select a project</h2>
                                    <div class="pdh-sub" id="pdProjectSub"></div>
                                </div>
                                <div class="pdh-controls">
                                    <select id="pdProjectSelect"><option value="">Loading projects…</option></select>
                                    <button class="btn btn-sm btn-outline" id="pdRefreshBtn" title="Refresh dashboard data">
                                        <i class="fas fa-rotate-right"></i> Refresh
                                    </button>
                                </div>
                            </div>
                            <div class="pdh-meta" id="pdProjectMeta"></div>
                        </div>
                    </div>

                    <div id="pdEmptyState" class="card pd-empty">
                        <div class="card-body">
                            <div class="pd-empty-icon"><i class="fas fa-folder-open"></i></div>
                            <h3>Pick a project to see its SEO health</h3>
                            <p>Create a project from the <strong>Clients</strong> page, then come back here for a one-glance view of keywords, ranks, technical health, competitors, alerts, and next actions.</p>
                        </div>
                    </div>

                    <div id="pdDashboardBody" style="display:none">
                        <!-- Summary tiles -->
                        <div class="pd-stats">
                            <div class="pd-stat">
                                <div class="pd-stat-icon blue"><i class="fas fa-key"></i></div>
                                <div class="pd-stat-info">
                                    <h3 id="pdStatKeywords">0</h3>
                                    <p>Target keywords</p>
                                </div>
                            </div>
                            <div class="pd-stat">
                                <div class="pd-stat-icon green"><i class="fas fa-trophy"></i></div>
                                <div class="pd-stat-info">
                                    <h3 id="pdStatTop10">0</h3>
                                    <p>Top 10 rankings</p>
                                </div>
                            </div>
                            <div class="pd-stat">
                                <div class="pd-stat-icon orange"><i class="fas fa-arrow-trend-up"></i></div>
                                <div class="pd-stat-info">
                                    <h3 id="pdStatAvg">—</h3>
                                    <p>Avg. position</p>
                                </div>
                            </div>
                            <div class="pd-stat">
                                <div class="pd-stat-icon purple"><i class="fas fa-spider"></i></div>
                                <div class="pd-stat-info">
                                    <h3 id="pdStatTech">—</h3>
                                    <p>Technical score</p>
                                </div>
                            </div>
                            <div class="pd-stat">
                                <div class="pd-stat-icon teal"><i class="fas fa-bullseye"></i></div>
                                <div class="pd-stat-info">
                                    <h3 id="pdStatVolume">0</h3>
                                    <p>Total search volume</p>
                                </div>
