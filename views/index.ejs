<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Advanced SEO Keyword Research, Competitor Analysis, and Rank Tracking Tool">
    <title><%= title %></title>
    <link rel="icon" type="image/x-icon" href="/public/favicon.ico">
    <link rel="stylesheet" href="/public/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/public/css/onpage.css">
    <link rel="stylesheet" href="/public/css/technical.css">
    <link rel="stylesheet" href="/public/css/project-dashboard.css">
    <link rel="stylesheet" href="/public/css/page-optimization.css">
    <link rel="stylesheet" href="/public/css/tasks.css">
    <link rel="stylesheet" href="/public/css/sitemap.css">

</head>
<body>
    <!-- Sidebar -->
    <nav class="sidebar">
        <div class="sidebar-header">
            <div class="logo">
                <i class="fas fa-search-dollar"></i>
                <span class="logo-text">Keyword Analyzer</span>
            </div>
            <button class="sidebar-collapse-btn" id="sidebarCollapseBtn" title="Collapse sidebar">
                <i class="fas fa-angles-left"></i>
            </button>
        </div>
        <ul class="nav-menu">
            
            <!-- Overview -->
            <li class="nav-group">
                <div class="nav-group-header" data-group="overview">
                    <span class="nav-group-label">Overview</span>
                    <i class="fas fa-chevron-down nav-group-arrow"></i>
                </div>
                <ul class="nav-group-items">
                    <li class="nav-item active" data-page="dashboard">
                        <i class="fas fa-chart-line"></i>
                        <span>Dashboard</span>
                    </li>
                    <li class="nav-item" data-page="clients" >
                        <i class="fas fa-briefcase"></i>
                        <span>Clients</span>
                    </li>
                    <li class="nav-item" data-page="project-dashboard" >
                        <i class="fas fa-tachometer-alt"></i>
                        <span>Project Dashboard</span>
                    </li>
                </ul>
            </li>
            <!-- Research & Analysis -->
            <li class="nav-group">
                <div class="nav-group-header" data-group="research">
                    <span class="nav-group-label">Research & Analysis</span>
                    <i class="fas fa-chevron-down nav-group-arrow"></i>
                </div>
                <ul class="nav-group-items">
                    <li class="nav-item" data-page="research">
                        <i class="fas fa-search"></i>
                        <span>Keyword Research</span>
                    </li>
                    <li class="nav-item" data-page="competitors">
                        <i class="fas fa-users"></i>
                        <span>Competitors</span>
                    </li>
                    <li class="nav-item" data-page="analysis">
                        <i class="fas fa-balance-scale"></i>
                        <span>Compare & Analyze</span>
                    </li>
                    <li class="nav-item" data-page="tracking">
                        <i class="fas fa-chart-bar"></i>
                        <span>Rank Tracking</span>
                    </li>
                    <li class="nav-item" data-page="gsc">
                        <i class="fas fa-chart-column"></i>
                        <span>Search Console</span>
                    </li>
                    <li class="nav-item" data-page="seo-performance">
                        <i class="fas fa-chart-line"></i>
                        <span>SEO Performance</span>
                    </li>
                    <li class="nav-item" data-page="search-visibility">
                        <i class="fas fa-magnifying-glass-chart"></i>
                        <span>Search Visibility</span>
                    </li>
                    <li class="nav-item" data-page="alerts">
                        <i class="fas fa-bell"></i>
                        <span>Alerts</span>
                        <span class="badge" id="alertBadge">0</span>
                    </li>
                </ul>
            </li>
            <!-- Audit -->
            <li class="nav-group">
                <div class="nav-group-header" data-group="audit">
                    <span class="nav-group-label">Audit</span>
                    <i class="fas fa-chevron-down nav-group-arrow"></i>
                </div>
                <ul class="nav-group-items">
                    <li class="nav-item" data-page="onpage">
                        <i class="fas fa-file-invoice"></i>
                        <span>On-Page SEO</span>
                    </li>
                    <li class="nav-item" data-page="page-optimization" >
                        <i class="fas fa-bullseye"></i>
                        <span>Page Optimization</span>
                    </li>
                    <li class="nav-item" data-page="page-speed">
                        <i class="fas fa-bolt"></i>
                        <span>PageSpeed</span>
                    </li>
                    <li class="nav-item" data-page="technical">
                        <i class="fas fa-spider"></i>
                        <span>Technical SEO</span>
                    </li>
                    <li class="nav-item" data-page="sitemap">
                        <i class="fas fa-sitemap"></i>
                        <span>Sitemap Generator</span>
                    </li>
                </ul>
            </li>
            <!-- Content -->
            <li class="nav-group">
                <div class="nav-group-header" data-group="content">
                    <span class="nav-group-label">Content</span>
                    <i class="fas fa-chevron-down nav-group-arrow"></i>
                </div>
                <ul class="nav-group-items">
                    <li class="nav-item" data-page="humanizer">
                        <i class="fas fa-pen-nib"></i>
                        <span>Content Humanizer</span>
                    </li>
                    <li class="nav-item" data-page="content-brief">
                        <i class="fas fa-file-lines"></i>
                        <span>Content Brief</span>
                    </li>
                    <li class="nav-item" data-page="reports">
                        <i class="fas fa-file-pdf"></i>
                        <span>Agency Reports</span>
                    </li>
                    <li class="nav-item" data-page="tasks">
                        <i class="fas fa-tasks"></i>
                        <span>SEO Tasks</span>
                    </li>
                </ul>
            </li>
            <!-- Agency Settings -->
            <li class="nav-group">
                <div class="nav-group-header" data-group="agency">
                    <span class="nav-group-label">Agency</span>
                    <i class="fas fa-chevron-down nav-group-arrow"></i>
                </div>
                <ul class="nav-group-items">
                    <li class="nav-item" data-page="agency-settings">
                        <i class="fas fa-building"></i>
                        <span>Agency Settings</span>
                    </li>
                    <li class="nav-item" data-page="agency-members">
                        <i class="fas fa-user-group"></i>
                        <span>Team Members</span>
                    </li>
                </ul>
            </li>
            <!-- Social Poster -->
            <li class="nav-group" style="display: none;">
                <div class="nav-group-header" data-group="social">
                    <span class="nav-group-label">Social Poster</span>
                    <i class="fas fa-chevron-down nav-group-arrow"></i>
                </div>
                <ul class="nav-group-items">
                    <li class="nav-item" data-page="social-upload">
                        <i class="fas fa-upload"></i>
                        <span>Upload</span>
                    </li>
                    <li class="nav-item" data-page="social-schedule">
                        <i class="fas fa-calendar-alt"></i>
                        <span>Schedule</span>
                    </li>
                    <li class="nav-item" data-page="social-platforms">
                        <i class="fas fa-hashtag"></i>
                        <span>Platforms</span>
                    </li>
                    <li class="nav-item" data-page="social-analytics">
                        <i class="fas fa-chart-pie"></i>
                        <span>Analytics</span>
                    </li>
                </ul>
            </li>
        </ul>
        <div class="sidebar-footer">
            <div class="version">v<%= version %></div>
            <div class="nav-item logout-button">
                <i class="fas fa-sign-out-alt"></i>
                <span class="logo-text">Logout</span>
            </div>
        </div>
    </nav>

    <!-- Command Palette Modal -->
    <div class="command-palette-overlay" id="commandPalette">
        <div class="command-palette">
            <div class="command-palette-input-wrap">
                <i class="fas fa-search"></i>
                <input type="text" id="commandPaletteInput" placeholder="Search pages, keywords, commands..." autocomplete="off">
                <kbd>ESC</kbd>
            </div>
            <div class="command-palette-results" id="commandPaletteResults"></div>
            <div class="command-palette-footer">
                <span><kbd>&uarr;</kbd><kbd>&darr;</kbd> navigate</span>
                <span><kbd>Enter</kbd> select</span>
                <span><kbd>Esc</kbd> close</span>
            </div>
        </div>
    </div>

    <!-- Sidebar Overlay for Mobile -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Back to Top Button -->
    <button class="back-to-top" id="backToTop" title="Back to top">
        <i class="fas fa-arrow-up"></i>
    </button>

    <!-- Main Content -->
    <main class="main-content">
        <!-- Header -->
        <header class="header">
            <div class="header-left">
                <button class="menu-toggle" id="menuToggle">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="header-title-area">
                    <nav class="breadcrumbs" id="breadcrumbs">
                        <span class="breadcrumb-item"><i class="fas fa-home"></i></span>
                    </nav>
                    <h1 id="pageTitle">Dashboard</h1>
                </div>
            </div>
            
            <div class="header-center">
                <div class="search-bar-container command-palette-trigger" id="commandPaletteTrigger" title="Search (Ctrl+K)">
                    <i class="fas fa-search search-icon"></i>
                    <span class="search-hint" style="flex:1; text-align:left;">Search everything...</span>
                    <kbd>Ctrl+K</kbd>
                </div>
            </div>

            <div class="header-right">
                <button class="header-action-btn icon-btn" id="themeToggle" title="Toggle dark mode">
                    <i class="fas fa-moon"></i>
                </button>
            </div>
        </header>

        <!-- Pages -->
        <div class="content">
            <!-- Dashboard Page -->
            <%- include('partials/pages/dashboard') %>

            <!-- Clients Page -->
            <%- include('partials/pages/clients') %>

            <!-- Project SEO Dashboard Page -->
            <%- include('partials/pages/project-dashboard') %>

            <!-- Keyword Research Page -->
            <%- include('partials/pages/research') %>

            <!-- Competitors Page -->
            <%- include('partials/pages/competitors') %>


            <!-- Analysis Page -->
            <%- include('partials/pages/analysis') %>

            <!-- Rank Tracking Page -->
            <%- include('partials/pages/tracking') %>


            <!-- Alerts Page -->
            <%- include('partials/pages/alerts') %>

            <!-- On-Page SEO Page -->
            <%- include('partials/pages/onpage') %>

            <!-- Page Optimization Page -->
            <%- include('partials/pages/page-optimization') %>

            <%- include('partials/pages/page-speed') %>

            <%- include('partials/pages/technical') %>

            <!-- Content Humanizer Page -->
            <%- include('partials/pages/humanizer') %>

            <!-- Content Brief Page -->
            <%- include('partials/pages/content-brief') %>

            <!-- Social Poster Pages (Iframed to preserve Tailwind styles) -->
            <div class="page" id="page-social-upload" style="padding: 0; min-height: calc(100vh - 60px);">
                <iframe id="iframe-social-upload" src="" data-src="/social/posts/upload" style="width: 100%; height: calc(100vh - 60px); border: none;"></iframe>
            </div>
            <div class="page" id="page-social-schedule" style="padding: 0; min-height: calc(100vh - 60px);">
                <iframe id="iframe-social-schedule" src="" data-src="/social/posts/schedule" style="width: 100%; height: calc(100vh - 60px); border: none;"></iframe>
            </div>
            <div class="page" id="page-social-platforms" style="padding: 0; min-height: calc(100vh - 60px);">
                <iframe id="iframe-social-platforms" src="" data-src="/social/platforms" style="width: 100%; height: calc(100vh - 60px); border: none;"></iframe>
            </div>
            <div class="page" id="page-social-analytics" style="padding: 0; min-height: calc(100vh - 60px);">
                <iframe id="iframe-social-analytics" src="" data-src="/social/analytics" style="width: 100%; height: calc(100vh - 60px); border: none;"></iframe>
            </div>

            <!-- ─── SEO Tasks Page ─── -->
            <%- include('partials/pages/tasks') %>

            <!-- Task Creation / Editing Modal -->
            <div class="modal" id="taskModal">
                <div class="modal-content" style="max-width: 500px;">
                    <div class="modal-header">
                        <h3 id="taskModalTitle">➕ Add Custom Task</h3>
                        <button class="modal-close" onclick="closeTaskModal()">&times;</button>
                    </div>
                    <div class="modal-body">
                        <form id="taskForm" onsubmit="saveTask(event)">
                            <input type="hidden" id="taskFormId">
                            <div class="form-group">
                                <label style="font-size: 12px; font-weight: 600;">Task Title</label>
                                <input type="text" id="taskFormTitle" placeholder="e.g. Add FAQ schema to homepage" style="width: 100%;" required>
                            </div>
                            <div class="form-group">
                                <label style="font-size: 12px; font-weight: 600;">Description</label>
                                <textarea id="taskFormDesc" placeholder="Explain what to do, target URLs, LSI keywords to add..." style="width: 100%; min-height: 80px;"></textarea>
                            </div>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                                <div class="form-group">
                                    <label style="font-size: 12px; font-weight: 600;">Category</label>
                                    <select id="taskFormCategory" style="width: 100%;">
                                        <option value="on-page">On-Page SEO</option>
                                        <option value="technical">Technical SEO</option>
                                        <option value="content">Content Strategy</option>
                                        <option value="link-building">Link Building</option>
                                        <option value="local-seo">Local SEO</option>
                                        <option value="general">General</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label style="font-size: 12px; font-weight: 600;">Priority</label>
                                    <select id="taskFormPriority" style="width: 100%;">
                                        <option value="critical">🚨 Critical</option>
                                        <option value="high">🟠 High</option>
                                        <option value="medium" selected>🟡 Medium</option>
                                        <option value="low">🟢 Low</option>
                                    </select>
                                </div>
                            </div>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                                <div class="form-group">
                                    <label style="font-size: 12px; font-weight: 600;">Impact</label>
                                    <select id="taskFormImpact" style="width: 100%;">
                                        <option value="high">High</option>
                                        <option value="medium" selected>Medium</option>
                                        <option value="low">Low</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label style="font-size: 12px; font-weight: 600;">Effort</label>
                                    <select id="taskFormEffort" style="width: 100%;">
                                        <option value="high">High</option>
                                        <option value="medium" selected>Medium</option>
                                        <option value="low">Low</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group">
                                <label style="font-size: 12px; font-weight: 600;">Status</label>
                                <select id="taskFormStatus" style="width: 100%;">
                                    <option value="todo" selected>To Do</option>
                                    <option value="in_progress">In Progress</option>
                                    <option value="completed">Completed</option>
                                </select>
                            </div>
                            <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 20px;">
                                <button type="button" class="btn btn-outline" onclick="closeTaskModal()">Cancel</button>
                                <button type="submit" class="btn btn-primary">Save Task</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- ─── Search Console (GSC) Page ─── -->
            <%- include('partials/pages/gsc') %><!-- end #page-gsc -->

            <%- include('partials/pages/seo-performance') %>



            <%- include('partials/pages/search-visibility') %>

            <!-- ─── Agency Settings Page ─── -->
            <%- include('partials/pages/agency-settings') %>

            <!-- ─── Agency Members Page ─── -->
            <%- include('partials/pages/agency-members') %>

            <!-- ─── Reports Page ─── -->
            <%- include('partials/pages/reports') %>

            <!-- ===== Sitemap Generator Page ===== -->
            <%- include('partials/pages/sitemap') %>
            <!-- ===== /Sitemap Generator Page ===== -->

        </div>
    </main>

    <!-- Competitor Analysis Modal -->
    <div class="modal" id="competitorAnalysisModal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>📊 Page Analysis</h3>
                <button class="modal-close">&times;</button>
            </div>
            <div class="modal-body" id="competitorAnalysisContent"></div>
        </div>
    </div>

    <!-- Loading Overlay -->
    <div class="loading-overlay" id="loadingOverlay">
        <div class="spinner"></div>
        <p id="loadingText">Analyzing...</p>
    </div>

    <!-- Toast Notifications -->
    <div class="toast-container" id="toastContainer"></div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jsdiff/5.2.0/diff.min.js"></script>
    <script src="/public/js/app.js"></script>
    <script src="/public/js/onpage.js"></script>
    <script src="/public/js/technical.js"></script>
    <script src="/public/js/contentBrief.js"></script>
    <script src="/public/js/project-dashboard.js"></script>
    <script src="/public/js/page-optimization.js"></script>
    <script src="/public/js/reports.js"></script>
    <script src="/public/js/seo-performance.js"></script>
    <script src="/public/js/search-visibility.js"></script>
    <script src="/public/js/tasks.js"></script>
    <script src="/public/js/agency.js"></script>
    <script src="/public/js/sitemap.js"></script>
    <script src="/public/js/sitemap-reports.js"></script>

</body>
</html>
