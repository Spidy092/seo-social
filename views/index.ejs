                                        <label class="sitemap-check">
                                            <input type="checkbox" id="smClientRespectNoindex" checked>
                                            <span>Respect noindex</span>
                                        </label>
                                        <label class="sitemap-check">
                                            <input type="checkbox" id="smClientFollowRedirects" checked>
                                            <span>Follow redirects</span>
                                        </label>
                                        <label class="sitemap-check">
                                            <input type="checkbox" id="smClientIncludeLastMod" checked>
                                            <span>Include lastmod</span>
                                        </label>
                                        <label class="sitemap-check">
                                            <input type="checkbox" id="smClientStripUtm" checked>
                                            <span>Strip UTM params</span>
                                        </label>
                                        <label class="sitemap-check">
                                            <input type="checkbox" id="smClientStripAllQueries">
                                            <span>Strip ALL query strings (full <code>stripQueryStrings</code>)</span>
                                        </label>
                                        <label class="sitemap-check">
                                            <input type="checkbox" id="smClientAutoSplit" checked>
                                            <span>Auto-split &gt;50 000 URLs (Google cap)</span>
                                        </label>
                                        <label class="sitemap-check">
                                            <input type="checkbox" id="smClientIncludePdfImg" checked>
                                            <span>Include PDFs in sitemap</span>
                                        </label>
                                        <label class="sitemap-check">
                                            <input type="checkbox" id="smClientIncludeImages" checked>
                                            <span>Include images (Google image sitemap)</span>
                                        </label>
                                        <label class="sitemap-check">
                                            <input type="checkbox" id="smClientIncludeVideo" checked>
                                            <span>Detect videos (Google video sitemap)</span>
                                        </label>
                                        <label class="sitemap-check">
                                            <input type="checkbox" id="smClientIncludeNews" checked>
                                            <span>Detect news articles (Google news sitemap)</span>
                                        </label>
                                        <label class="sitemap-check">
                                            <input type="checkbox" id="smClientMergeGsc" checked>
                                            <span>Merge GSC pages</span>
                                        </label>
                                        <label class="sitemap-check">
                                            <input type="checkbox" id="smClientMergeRanking" checked>
                                            <span>Merge ranking pages</span>
                                        </label>
                                    </div>
                                    <button class="btn btn-primary sitemap-generate-btn" id="smClientGenBtn">
                                        <i class="fas fa-play"></i> Generate &amp; Save
                                    </button>
                                </div>
                            </div>

                            <!-- Right: results + history -->
                            <div class="sitemap-results-wrap">
                                <!-- idle -->
                                <div class="sitemap-idle" id="smClientIdle">
                                    <i class="fas fa-user-tie sitemap-idle-icon"></i>
                                    <h4>Select a client to begin</h4>
                                    <p>In client mode the crawler also pulls in pages from Google Search Console and your ranking data before building the sitemap.</p>
                                </div>

                                <!-- progress -->
                                <div class="sitemap-progress-wrap" id="smClientProgress" style="display:none">
                                    <div class="sitemap-progress-header">
                                        <span class="sitemap-pulse"></span>
                                        <span id="smClientProgressLabel">Initialising crawl…</span>
                                    </div>
                                    <div class="sitemap-progress-bar-track">
                                        <div class="sitemap-progress-bar" id="smClientProgressBar"></div>
                                    </div>
                                    <div class="sitemap-progress-stats" id="smClientProgressStats"></div>
                                </div>

                                <!-- result card -->
                                <div class="sitemap-result-card card" id="smClientResult" style="display:none">
                                    <div class="card-header">
                                        <div>
                                            <h3 id="smClientResultTitle">Sitemap ready</h3>
                                            <span class="header-hint" id="smClientResultSub"></span>
                                        </div>
                                        <div style="display:flex;gap:8px;flex-wrap:wrap;">
                                            <button class="btn btn-sm btn-outline" id="smClientCopyBtn"><i class="fas fa-copy"></i> Copy XML</button>
                                            <button class="btn btn-sm btn-primary" id="smClientDownloadBtn"><i class="fas fa-download"></i> Download</button>
                                            <button class="btn btn-sm btn-outline" id="smClientAuditBtn"><i class="fas fa-file-csv"></i> Download SEO Audit (CSV)</button>
                                        </div>
                                    </div>
                                    <div class="card-body sitemap-xml-wrap">
                                        <pre class="sitemap-xml-preview" id="smClientXmlPreview"></pre>
                                    </div>
                                    <div class="sitemap-result-footer">
                                        <button class="btn btn-sm btn-outline" id="smClientNewBtn"><i class="fas fa-refresh"></i> New crawl</button>
                                    </div>
                                </div>

                                <!-- error card -->
                                <div class="sitemap-error-card" id="smClientError" style="display:none">
                                    <i class="fas fa-triangle-exclamation"></i>
                                    <div>
                                        <strong id="smClientErrorTitle">Crawl failed</strong>
                                        <p id="smClientErrorMsg"></p>
                                    </div>
                                </div>

                                <!-- history -->
                                <div class="card sitemap-history-card" id="smHistoryCard" style="display:none">
                                    <div class="card-header">
                                        <h3><i class="fas fa-clock-rotate-left"></i> Generation History</h3>
                                        <button class="btn btn-sm btn-outline" id="smHistoryRefreshBtn"><i class="fas fa-rotate-right"></i></button>
                                    </div>
                                    <div class="card-body" id="smHistoryList">
                                        <p class="text-muted" style="text-align:center;padding:20px;">No history yet.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
            <!-- ===== /Sitemap Generator Page ===== -->

        </div>
    </main>

    <!-- Competitor Analysis Modal -->
    <div class="modal" id="competitorAnalysisModal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>📊 Page Analysis</h3>
                <button class="modal-close">&times;</button>
            </div>
            <div class="modal-body" id="competitorAnalysisContent"></div>
        </div>
    </div>

    <!-- Loading Overlay -->
    <div class="loading-overlay" id="loadingOverlay">
        <div class="spinner"></div>
        <p id="loadingText">Analyzing...</p>
    </div>

    <!-- Toast Notifications -->
    <div class="toast-container" id="toastContainer"></div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jsdiff/5.2.0/diff.min.js"></script>
    <script src="/public/js/app.js"></script>
    <script src="/public/js/onpage.js"></script>
    <script src="/public/js/technical.js"></script>
    <script src="/public/js/contentBrief.js"></script>
    <script src="/public/js/project-dashboard.js"></script>
    <script src="/public/js/page-optimization.js"></script>
    <script src="/public/js/reports.js"></script>
    <script src="/public/js/seo-performance.js"></script>
    <script src="/public/js/search-visibility.js"></script>
    <script src="/public/js/tasks.js"></script>
    <script src="/public/js/agency.js"></script>
    <script src="/public/js/sitemap.js"></script>
    <script src="/public/js/sitemap-reports.js"></script>

</body>
</html>
