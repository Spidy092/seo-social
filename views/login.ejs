<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#F6F5F0">
    <meta name="color-scheme" content="light dark">
    <meta name="description" content="Evidence Desk — sign in to continue to your SEO workspace">
    <title>Sign in — Evidence Desk</title>
    <link rel="icon" type="image/x-icon" href="/public/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/public/css/style.css">
    <link rel="stylesheet" href="/public/css/evidence-desk.css">
    <style>
        /* Login — Evidence Desk only, no Tailwind/Outfit/blobs */
        body.ed-login {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 16px;
            background: var(--ed-canvas);
            color: var(--ed-ink);
            font-family: "Plus Jakarta Sans", sans-serif;
        }
        .ed-login-wrap { width: 100%; max-width: 440px; }
        .ed-login-kicker {
            margin-bottom: 18px;
            text-align: center;
        }
        .ed-login-card {
            background: var(--ed-surface);
            border: 1px solid var(--ed-line);
            border-radius: 10px;
            overflow: hidden;
        }
        .ed-login-head {
            padding: 28px 28px 0 28px;
            text-align: center;
        }
        .ed-login-mark {
            width: 36px; height: 36px;
            display: inline-flex; align-items: center; justify-content: center;
            background: var(--ed-ink); color: var(--ed-surface);
            border-radius: 6px; font-weight: 800; letter-spacing: 0.04em; font-size: 12px;
        }
        .ed-login-title { margin: 14px 0 6px; font-size: 28px; line-height: 1.05; letter-spacing: -0.04em; font-weight: 800; text-wrap: balance; }
        .ed-login-sub { margin: 0; color: var(--ed-muted); font-size: 13px; line-height: 1.5; }
        .ed-login-form { padding: 22px 28px 24px; }
        .ed-login-field { margin-bottom: 14px; }
        .ed-login-field label {
            display: block; margin-bottom: 7px;
            color: var(--ed-ink); font: 800 10px "IBM Plex Mono", monospace; letter-spacing: 0.06em; text-transform: uppercase;
        }
        .ed-login-field label small { float: right; text-transform: none; letter-spacing: 0; font-weight: 600; }
        .ed-login-field label small a { color: var(--ed-copper-dark); text-decoration: none; }
        .ed-login-field label small a:hover { color: var(--ed-copper); }
        .ed-input-wrap { position: relative; }
        .ed-input-wrap i.ed-input-icon {
            position: absolute; left: 11px; top: 50%; transform: translateY(-50%);
            color: var(--ed-muted); font-size: 13px; pointer-events: none;
        }
        .ed-login-field input {
            width: 100%; min-height: 44px;
            padding: 11px 12px 11px 34px;
            border: 1px solid var(--ed-line); border-radius: 6px;
            background: var(--ed-surface); color: var(--ed-ink);
            font-size: 13px; font-weight: 500;
        }
        .ed-login-field input::placeholder { color: #9AA6A0; }
        .ed-login-field input:focus { border-color: var(--ed-copper); box-shadow: 0 0 0 3px rgba(183,85,44,0.12); outline: 0; }
        .ed-login-field input[aria-invalid="true"] { border-color: var(--ed-red); }
        .ed-field-hint { margin-top: 6px; color: var(--ed-muted); font-size: 10px; line-height: 1.4; }
        .ed-alert {
            display: flex; gap: 10px; align-items: flex-start;
            padding: 10px 12px; border-radius: 6px; border: 1px solid;
            font-size: 12px; line-height: 1.45; margin-bottom: 16px;
        }
        .ed-alert-success { background: var(--ed-green-soft); border-color: #CDE3D3; color: #234132; }
        .ed-alert-error { background: #FDF0EF; border-color: #E8C4C0; color: #6B2E2A; }
        .ed-alert i { margin-top: 1px; font-size: 13px; flex-shrink: 0; }
        .ed-login-submit {
            width: 100%; min-height: 44px;
            display: inline-flex; align-items: center; justify-content: center; gap: 8px;
            background: var(--ed-copper); color: #fff; border: 1px solid transparent; border-radius: 6px;
            font-size: 11px; font-weight: 800; letter-spacing: -0.01em; cursor: pointer;
            transition: transform 150ms ease, background 150ms ease;
        }
        .ed-login-submit:hover { background: var(--ed-copper-dark); transform: translateY(-1px); }
        .ed-login-submit:active { transform: none; }
        .ed-login-submit:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
        .ed-login-submit:focus-visible { outline: 3px solid rgba(183,85,44,0.3); outline-offset: 2px; }
        .ed-login-meta {
            margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--ed-line);
            text-align: center;
        }
        .ed-login-toggle {
            background: none; border: 0; padding: 6px 8px; cursor: pointer;
            color: var(--ed-muted); font-size: 12px; font-weight: 600;
        }
        .ed-login-toggle strong { color: var(--ed-copper-dark); }
        .ed-login-toggle:hover strong { color: var(--ed-copper); }
        .ed-login-toggle:focus-visible { outline: 3px solid rgba(183,85,44,0.3); outline-offset: 2px; border-radius: 4px; }
        .ed-login-foot {
            margin-top: 18px; text-align: center;
            color: var(--ed-muted); font: 10px "IBM Plex Mono", monospace; line-height: 1.6;
        }
        .ed-login-foot a { color: var(--ed-muted); text-decoration: none; }
        .ed-login-foot a:hover { color: var(--ed-ink); }
        .ed-login-foot span.dot { margin: 0 6px; color: var(--ed-line-strong); }
        @media (prefers-reduced-motion: reduce) { * { transition-duration: 0.01ms !important; } }
    </style>
</head>
<body class="ed-login">
    <div class="ed-login-wrap">
        <div class="ed-login-kicker">
            <p class="ed-eyebrow" style="margin:0 0 6px; text-align:center;">Evidence desk / sign in</p>
            <div style="color:var(--ed-muted); font:10px 'IBM Plex Mono',monospace;">Paper · Ink · Copper · Mono</div>
        </div>

        <div class="ed-login-card">
            <div class="ed-login-head">
                <div class="ed-login-mark" aria-hidden="true">ED</div>
                <h1 class="ed-login-title" id="formTitle">Welcome back</h1>
                <p class="ed-login-sub" id="formSubtitle">Sign in to your evidence workspace.</p>
            </div>

            <form id="authForm" action="/login" method="POST" class="ed-login-form">
                <% if (typeof success !== 'undefined' && success === 'register') { %>
                    <div class="ed-alert ed-alert-success" role="status">
                        <i class="fas fa-circle-check" aria-hidden="true"></i>
                        <span><strong>Account created.</strong> Please sign in with your new credentials.</span>
                    </div>
                <% } %>

                <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
                    <div class="ed-alert ed-alert-error" role="alert">
                        <i class="fas fa-circle-exclamation" aria-hidden="true"></i>
                        <span><%= error %></span>
                    </div>
                <% } %>

                <div class="ed-login-field">
                    <label for="emailInput">Email address</label>
                    <div class="ed-input-wrap">
                        <i class="fas fa-envelope ed-input-icon" aria-hidden="true"></i>
                        <input id="emailInput" type="email" name="email" required autocomplete="email" spellcheck="false" inputmode="email" placeholder="name@example.com…" aria-describedby="emailHint">
                    </div>
                    <div class="ed-field-hint" id="emailHint">Use your workspace email. We never share it.</div>
                </div>

                <div class="ed-login-field">
                    <label for="passwordInput">Password <small><a href="#" tabindex="-1">Forgot?</a></small></label>
                    <div class="ed-input-wrap">
                        <i class="fas fa-lock ed-input-icon" aria-hidden="true"></i>
                        <input id="passwordInput" type="password" name="password" required autocomplete="current-password" placeholder="••••••••" aria-describedby="passwordHint">
                    </div>
                    <div class="ed-field-hint" id="passwordHint">At least 6 characters. Credentials stay on this device only.</div>
                </div>

                <button type="submit" id="submitBtn" class="ed-login-submit">
                    <span>Sign in</span>
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </button>

                <div class="ed-login-meta">
                    <button type="button" id="toggleMode" class="ed-login-toggle" aria-label="Switch to registration form">
                        Don't have an account? <strong>Register</strong>
                    </button>
                </div>
            </form>
        </div>

        <div class="ed-login-foot">
            <a href="#">Privacy</a><span class="dot">·</span><a href="#">Terms</a>
            <div style="margin-top:6px;">&copy; 2026 Evidence Desk</div>
        </div>
    </div>

    <script>
        const authForm = document.getElementById('authForm');
        const formTitle = document.getElementById('formTitle');
        const formSubtitle = document.getElementById('formSubtitle');
        const submitBtn = document.getElementById('submitBtn');
        const toggleMode = document.getElementById('toggleMode');
        const emailInput = document.getElementById('emailInput');
        const passwordInput = document.getElementById('passwordInput');
        let isLogin = true;

        function syncToggleLabels() {
            if (isLogin) {
                authForm.action = '/login';
                formTitle.textContent = 'Welcome back';
                formSubtitle.textContent = 'Sign in to your evidence workspace.';
                submitBtn.innerHTML = '<span>Sign in</span><i class="fas fa-arrow-right" aria-hidden="true"></i>';
                toggleMode.innerHTML = 'Don\u0027t have an account? <strong>Register</strong>';
                passwordInput.setAttribute('autocomplete', 'current-password');
                toggleMode.setAttribute('aria-label', 'Switch to registration form');
            } else {
                authForm.action = '/register';
                formTitle.textContent = 'Create account';
                formSubtitle.textContent = 'Start a workspace — paper, ink, copper, no guesses.';
                submitBtn.innerHTML = '<span>Create account</span><i class="fas fa-arrow-right" aria-hidden="true"></i>';
                toggleMode.innerHTML = 'Already have an account? <strong>Sign in</strong>';
                passwordInput.setAttribute('autocomplete', 'new-password');
                toggleMode.setAttribute('aria-label', 'Switch to sign-in form');
            }
        }

        toggleMode.addEventListener('click', () => {
            isLogin = !isLogin;
            // reduced-motion safe: only opacity transform
            const card = authForm.closest('.ed-login-card');
            card.style.opacity = '0.96';
            setTimeout(() => { card.style.opacity = '1'; }, 120);
            syncToggleLabels();
        });

        authForm.addEventListener('submit', () => {
            submitBtn.disabled = true;
            const original = submitBtn.innerHTML;
            submitBtn.innerHTML = '<span class="ed-spinner" style="width:14px;height:14px;border-width:2px;display:inline-block;vertical-align:middle;" aria-hidden="true"></span><span>Please wait…</span>';
            setTimeout(() => {
                // re-enable only if page hasn't navigated (error case)
                if (document.visibilityState === 'visible') {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = original;
                }
            }, 4000);
        });
    </script>
</body>
</html>
