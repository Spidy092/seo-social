<div class="page" id="page-clients">
                <div class="clients-container">
                    <div class="clients-grid">
                        <div class="card">
                            <div class="card-header">
                                <h3>Client Information</h3>
                                <span class="header-hint">Store client, website, location, competitors, services, and goals</span>
                            </div>
                            <div class="card-body">
                                <input type="hidden" id="clientIdInput">
                                <!-- Wizard Steps Indicator -->
                                <div class="wizard-steps">
                                    <div class="wizard-step active" data-step="1">
                                        <span class="wizard-step-num">1</span>
                                        <span class="wizard-step-label">Basic Info</span>
                                    </div>
                                    <div class="wizard-step-line"></div>
                                    <div class="wizard-step" data-step="2">
                                        <span class="wizard-step-num">2</span>
                                        <span class="wizard-step-label">Market</span>
                                    </div>
                                    <div class="wizard-step-line"></div>
                                    <div class="wizard-step" data-step="3">
                                        <span class="wizard-step-num">3</span>
                                        <span class="wizard-step-label">Goals</span>
                                    </div>
                                </div>

                                <!-- Step 1: Basic Info -->
                                <div class="wizard-panel active" data-panel="1">
                                    <div class="form-row">
                                        <div class="form-group">
                                            <label for="clientNameInput">Client name <span class="required" aria-hidden="true">*</span></label>
                                            <input type="text" id="clientNameInput" name="clientName" autocomplete="organization" spellcheck="false" placeholder="e.g. Acme Dental Clinic…" required>
                                            <div class="field-error"><i class="fas fa-exclamation-circle"></i> <span></span></div>
                                        </div>
                                        <div class="form-group">
                                            <label for="clientWebsiteInput">Website URL <span class="required" aria-hidden="true">*</span></label>
                                            <input type="text" id="clientWebsiteInput" name="website" autocomplete="url" inputmode="url" spellcheck="false" placeholder="https://example.com…" required>
                                            <div class="field-error"><i class="fas fa-exclamation-circle"></i> <span></span></div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="clientIndustryInput">Industry / niche</label>
                                        <input type="text" id="clientIndustryInput" name="industry" autocomplete="off" spellcheck="false" placeholder="e.g. Local dental clinic…">
                                    </div>
                                    <div class="wizard-nav">
                                        <span></span>
                                        <button type="button" class="btn btn-primary wizard-next" data-next="2">Next <i class="fas fa-arrow-right" aria-hidden="true"></i></button>
                                    </div>
                                </div>

                                <!-- Step 2: Market -->
                                <div class="wizard-panel" data-panel="2">
                                    <div class="form-group">
                                        <label for="clientLocationsInput">Target locations</label>
                                        <input type="text" id="clientLocationsInput" name="locations" autocomplete="address-level2" spellcheck="false" placeholder="Bangalore, Whitefield, India…">
                                    </div>
                                    <div class="form-group">
                                        <label for="clientCompetitorsInput">Competitors</label>
                                        <input type="text" id="clientCompetitorsInput" name="competitors" autocomplete="off" spellcheck="false" inputmode="url" placeholder="competitor1.com, competitor2.com…">
                                    </div>
                                    <div class="form-group">
                                        <label for="clientServicesInput">Services / products</label>
                                        <input type="text" id="clientServicesInput" name="services" autocomplete="off" spellcheck="false" placeholder="SEO, web design, PPC…">
                                    </div>
                                    <div class="wizard-nav">
                                        <button type="button" class="btn btn-outline wizard-prev" data-prev="1"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back</button>
                                        <button type="button" class="btn btn-primary wizard-next" data-next="3">Next <i class="fas fa-arrow-right" aria-hidden="true"></i></button>
                                    </div>
                                </div>

                                <!-- Step 3: Goals -->
                                <div class="wizard-panel" data-panel="3">
                                    <div class="form-group">
                                        <label for="clientAudienceInput">Audience</label>
                                        <input type="text" id="clientAudienceInput" name="audience" autocomplete="off" spellcheck="false" placeholder="e.g. homeowners, startup founders…">
                                    </div>
                                    <div class="form-group">
                                        <label for="clientGoalsInput">SEO goals</label>
                                        <textarea id="clientGoalsInput" name="goals" autocomplete="off" spellcheck="true" placeholder="Rank service pages, grow local leads, build topical authority…"></textarea>
                                    </div>
                                    <div class="wizard-nav">
                                        <button type="button" class="btn btn-outline wizard-prev" data-prev="2"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back</button>
                                        <button type="button" class="btn btn-primary" id="saveClientBtn"><i class="fas fa-save" aria-hidden="true"></i> Save client</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card">
                            <div class="card-header">
                                <h3>Client Projects</h3>
                                <span class="header-hint">Create SEO workstreams like Local SEO, Blogs, or Service Pages</span>
                            </div>
                            <div class="card-body">
                                <div class="form-group">
                                    <label for="projectClientSelect">Selected client</label>
                                    <select id="projectClientSelect" name="projectClient"><option value="">Choose a client…</option></select>
                                </div>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="projectNameInput">Project name</label>
                                        <input type="text" id="projectNameInput" name="projectName" autocomplete="off" spellcheck="false" placeholder="Local SEO campaign…">
                                    </div>
                                    <div class="form-group">
                                        <label for="projectTypeInput">Project type</label>
                                        <select id="projectTypeInput" name="projectType">
                                            <option value="keyword-research">Keyword Research</option>
                                            <option value="local-seo">Local SEO</option>
                                            <option value="content-plan">Content Plan</option>
                                            <option value="competitor-gap">Competitor Gap</option>
                                            <option value="service-pages">Service Pages</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="projectLocationInput">Target location</label>
                                    <input type="text" id="projectLocationInput" name="projectLocation" autocomplete="address-level2" spellcheck="false" placeholder="e.g. Bangalore…">
                                </div>
                                <div class="form-group">
                                    <label for="projectGoalsInput">Project goal</label>
                                    <textarea id="projectGoalsInput" name="projectGoal" autocomplete="off" spellcheck="true" placeholder="What should this project achieve?…"></textarea>
                                </div>
                                <button type="button" class="btn btn-primary" id="saveProjectBtn"><i class="fas fa-folder-plus" aria-hidden="true"></i> Add project</button>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h3>Saved Clients</h3>
                            <button type="button" class="btn btn-sm btn-outline" id="refreshClientsBtn" aria-label="Refresh clients"><i class="fas fa-rotate-right" aria-hidden="true"></i> Refresh</button>
                        </div>
                        <div class="card-body" id="clientsList"></div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h3>Selected Client Projects</h3>
                        </div>
                        <div class="card-body" id="clientProjectsList"><p class="text-muted">Select a client to view projects.</p></div>
                    </div>
                </div>
            </div>