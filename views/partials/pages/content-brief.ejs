<div class="page" id="page-content-brief">
                <div class="research-container">
                    <div class="card">
                        <div class="card-header">
                            <h3>Content Brief Generator</h3>
                            <span class="header-hint">Turn a keyword into a practical SEO content plan using SERP and competitor signals</span>
                        </div>
                        <div class="card-body">
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="briefKeyword">Target keyword</label>
                                    <input type="text" id="briefKeyword" name="keyword" autocomplete="off" spellcheck="false" inputmode="search" placeholder="e.g. web design company in Bangalore…">
                                </div>
                                <div class="form-group">
                                    <label for="briefLocation">Location</label>
                                    <input type="text" id="briefLocation" name="location" value="India" autocomplete="address-level2" spellcheck="false" placeholder="India, Bangalore, Whitefield…">
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="briefDomain">Your domain</label>
                                    <input type="text" id="briefDomain" name="domain" autocomplete="off" inputmode="url" spellcheck="false" placeholder="example.com…">
                                </div>
                                <div class="form-group">
                                    <label for="briefAudience">Audience</label>
                                    <input type="text" id="briefAudience" name="audience" autocomplete="off" spellcheck="false" placeholder="startup founders, local customers…">
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="briefBrandVoice">Brand voice</label>
                                    <input type="text" id="briefBrandVoice" name="voice" autocomplete="off" spellcheck="false" placeholder="clear, expert, practical…">
                                </div>
                                <div class="form-group">
                                    <label for="briefProjectSelect">Attach to project</label>
                                    <select id="briefProjectSelect" name="project">
                                        <option value="">Do not attach to project</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="briefNumResults">Competitor depth</label>
                                    <select id="briefNumResults" name="numResults">
                                        <option value="5">Top 5</option>
                                        <option value="10" selected>Top 10</option>
                                        <option value="20">Top 20</option>
                                    </select>
                                </div>
                            </div>
                            <label class="checkbox-label" style="display:flex;align-items:center;gap:10px;margin-bottom:16px;">
                                <input type="checkbox" id="briefUseAi" checked>
                                <span>Use AI to polish title, meta, and outline when configured</span>
                            </label>
                            <button type="button" class="btn btn-primary" id="generateBriefBtn" style="min-height:44px;width:220px;justify-content:center;font-weight:600;">
                                <i class="fas fa-file-lines" aria-hidden="true"></i> Generate brief
                            </button>
                        </div>
                    </div>

                    <div id="contentBriefResults" style="display:none;margin-top:20px;">
                        <div class="metrics-grid" style="margin-bottom:20px;">
                            <div class="metric-card"><div class="metric-header"><span class="metric-label">Intent</span><span class="metric-icon"><i class="fas fa-bullseye"></i></span></div><div class="metric-value" id="briefIntent">-</div></div>
                            <div class="metric-card"><div class="metric-header"><span class="metric-label">Page Type</span><span class="metric-icon"><i class="fas fa-layer-group"></i></span></div><div class="metric-value" id="briefPageType">-</div></div>
                            <div class="metric-card"><div class="metric-header"><span class="metric-label">Target Words</span><span class="metric-icon"><i class="fas fa-align-left"></i></span></div><div class="metric-value" id="briefWordCount">-</div></div>
                            <div class="metric-card"><div class="metric-header"><span class="metric-label">AI Enhanced</span><span class="metric-icon"><i class="fas fa-wand-magic-sparkles"></i></span></div><div class="metric-value" id="briefAiStatus">-</div></div>
                        </div>

                        <div class="card" style="margin-bottom:20px;">
                            <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;gap:12px;">
                                <h3>SEO Brief</h3>
                                <button class="btn btn-sm btn-outline" id="sendBriefToHumanizerBtn"><i class="fas fa-pen-nib"></i> Send to Humanizer</button>
                            </div>
                            <div class="card-body" id="briefSummary"></div>
                        </div>

                        <div class="dashboard-grid">
                            <div class="card"><div class="card-header"><h3>Outline</h3></div><div class="card-body" id="briefOutline"></div></div>
                            <div class="card"><div class="card-header"><h3>Entities and Topics</h3></div><div class="card-body" id="briefEntities"></div></div>
                            <div class="card"><div class="card-header"><h3>FAQs from SERP</h3></div><div class="card-body" id="briefFaqs"></div></div>
                            <div class="card"><div class="card-header"><h3>Schema and Links</h3></div><div class="card-body" id="briefSchemaLinks"></div></div>
                        </div>

                        <div class="card" style="margin-top:20px;">
                            <div class="card-header"><h3>Competitor Examples</h3></div>
                            <div class="card-body" id="briefCompetitors"></div>
                        </div>
                    </div>
                </div>
            </div>