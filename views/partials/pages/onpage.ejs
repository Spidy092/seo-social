<div class="page" id="page-onpage">
                <div class="onpage-container">

                    <!-- Input Card -->
                    <div class="card onpage-form-card">
                        <div class="card-header">
                            <h3>On-Page SEO Analyzer</h3>
                            <span class="header-hint">Paste a URL or raw HTML · Get 47 checks · AI writes the fixes</span>
                        </div>
                        <div class="card-body">
                            <div class="onpage-input-row" style="margin-bottom: 12px;">
                                <label for="onpage-project-select" class="sr-only">Link to project</label>
                                <select id="onpage-project-select" name="project" style="flex:1">
                                    <option value="">(Optional) Link to project &amp; auto-suggest URLs…</option>
                                </select>
                            </div>

                            <div class="onpage-input-row">
                                <label for="onpage-input-mode" class="sr-only">Input mode</label>
                                <select id="onpage-input-mode" name="inputMode" onchange="toggleInputMode()">
                                    <option value="url">Analyze by URL</option>
                                    <option value="html">Paste HTML code</option>
                                </select>
                                <label for="onpage-keyword-input" class="sr-only">Target keyword</label>
                                <input type="text" id="onpage-keyword-input" name="keyword" autocomplete="off" spellcheck="false" inputmode="search"
                                       placeholder="Target keyword, e.g. web design bangalore…" style="flex:2">
                            </div>

                            <div id="onpage-url-row" class="onpage-input-row">
                                <label for="onpage-url-input" class="sr-only">URL to analyze</label>
                                <input type="url" id="onpage-url-input" name="url" autocomplete="url" inputmode="url" spellcheck="false"
                                       placeholder="https://yoursite.com/page-to-analyze…"
                                       list="onpage-suggested-urls"
                                       style="flex:1">
                                <datalist id="onpage-suggested-urls"></datalist>
                            </div>

                            <div id="onpage-html-row" style="display:none;margin-bottom:12px">
                                <textarea id="onpage-html-input"
                                          placeholder="Paste your full page HTML here…"></textarea>
                            </div>

                            <button type="button" class="btn btn-primary" id="onpage-analyze-btn" style="min-height:44px;">
                                <i class="fas fa-search" aria-hidden="true"></i> Analyze page
                            </button>
                        </div>
                    </div>

                    <!-- Recent Audits / History -->
                    <div id="onpage-history-container" style="display:none; margin-bottom: 24px;">
                        <h4 style="margin-bottom: 12px; font-weight: 600; font-size: 1.1rem; color: var(--text);">Recent Project Audits</h4>
                        <div id="onpage-history-list" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px;">
                            <!-- History cards will be injected here -->
                        </div>
                    </div>

                    <!-- Results (hidden until analysis runs) -->
                    <div id="onpage-results" style="display:none">

                        <!-- Row: Overall score + Snapshot -->
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px">

                            <!-- Overall Score -->
                            <div class="card">
                                <div class="card-header"><h3>Overall Score</h3></div>
                                <div class="onpage-score-wrap">
                                    <div class="onpage-score-ring">
                                        <svg width="120" height="120" viewBox="0 0 120 120">
                                            <circle class="track" cx="60" cy="60" r="45"/>
                                            <circle class="fill" id="onpage-score-circle" cx="60" cy="60" r="45"
                                                    stroke-dasharray="283" stroke-dashoffset="283"/>
                                        </svg>
                                        <div class="onpage-score-num">
                                            <div class="onpage-score-big" id="onpage-overall-score">—</div>
                                            <div class="onpage-score-slash">/100</div>
                                        </div>
                                    </div>
                                    <div class="onpage-score-info">
                                        <div class="score-label" id="onpage-overall-label">—</div>
                                        <div class="score-sublabel" id="onpage-overall-info">Run analysis to see results</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Page Snapshot + SERP Preview -->
                            <div class="card">
                                <div class="card-header">
                                    <h3>Page Snapshot</h3>
                                    <span class="header-hint">SERP preview + key metrics</span>
                                </div>
                                <!-- SERP Preview -->
                                <div class="serp-preview-wrap" id="serp-preview-wrap">
                                    <div class="serp-preview-label">Google Search Preview</div>
                                    <div class="serp-preview-box">
                                        <div class="serp-favicon"><i class="fas fa-globe"></i></div>
                                        <div class="serp-text-block">
                                            <div class="serp-site-name" id="serp-site-name">yoursite.com</div>
                                            <div class="serp-breadcrumb" id="serp-breadcrumb">yoursite.com › page</div>
                                            <div class="serp-title-row">
                                                <div class="serp-title" id="serp-title">Page title will appear here</div>
                                                <div class="serp-char-count" id="serp-title-chars"></div>
                                            </div>
                                            <div class="serp-desc" id="serp-desc">Meta description will appear here after analysis runs.</div>
                                            <div class="serp-char-count" id="serp-desc-chars"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="onpage-snapshot" id="onpage-snapshot"></div>
                            </div>
                        </div>

                        <!-- Category Scores -->
                        <div class="card" style="margin-bottom:20px">
                            <div class="card-header">
                                <h3>Score by Category</h3>
                                <span class="header-hint">Click a category to filter issues below</span>
                            </div>
                            <div class="onpage-categories" id="onpage-category-scores"></div>
                        </div>

                        <!-- Issues List -->
                        <div class="card">
                            <div class="onpage-issues-header">
                                <h3>All Issues</h3>
                                <div class="onpage-issues-controls">
                                    <button class="onpage-filter-btn active" onclick="filterByCategory('all')">All</button>
                                    <button class="onpage-filter-btn" onclick="filterByCategory('title')">Title</button>
                                    <button class="onpage-filter-btn" onclick="filterByCategory('meta')">Meta</button>
                                    <button class="onpage-filter-btn" onclick="filterByCategory('headings')">Headings</button>
                                    <button class="onpage-filter-btn" onclick="filterByCategory('content')">Content</button>
                                    <button class="onpage-filter-btn" onclick="filterByCategory('images')">Images</button>
                                    <button class="onpage-filter-btn" onclick="filterByCategory('schema')">Schema</button>
                                    <button class="onpage-filter-btn" onclick="filterByCategory('technical')">Technical</button>
                                    <button class="onpage-export-btn" onclick="downloadReport()" title="Download full audit as text file">
                                        <i class="fas fa-download"></i> Export
                                    </button>
                                </div>
                            </div>
                            <div id="onpage-issues-list"></div>
                        </div>

                        <!-- Extracted Page Data (Raw Values) -->
                        <div class="card" style="margin-top:20px;">
                            <div class="card-header">
                                <h3>📋 Extracted Page Data</h3>
                                <span class="header-hint">View the exact links, headings, and tags found on the page</span>
                            </div>
                            <div class="card-body" style="padding:0">
                                <div class="onpage-data-accordion">
                                    <details class="data-group">
                                        <summary>🖼️ Images & Alt Text (<span id="data-img-count">0</span>)</summary>
                                        <div class="data-content" id="data-images-list"></div>
                                    </details>
                                    <details class="data-group">
                                        <summary>🔗 Internal Links (<span id="data-link-count">0</span>)</summary>
                                        <div class="data-content" id="data-links-list"></div>
                                    </details>
                                    <details class="data-group">
                                        <summary>📝 Headings (H1 & H2)</summary>
                                        <div class="data-content" id="data-headings-list"></div>
                                    </details>
                                    <details class="data-group">
                                        <summary>⚙️ Meta & Technical Tags</summary>
                                        <div class="data-content" id="data-technical-list"></div>
                                    </details>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>