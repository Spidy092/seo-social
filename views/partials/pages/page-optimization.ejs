                                <div class="po-category-info">
                                    <h4>Internal linking</h4>
                                    <p id="poCatLinksSummary">—</p>
                                </div>
                                <div class="po-category-priority" id="poCatLinksPriority">—</div>
                            </div>
                            <div class="po-category" data-category="keyword-coverage">
                                <div class="po-category-icon"><i class="fas fa-key"></i></div>
                                <div class="po-category-info">
                                    <h4>Keyword &amp; entity coverage</h4>
                                    <p id="poCatEntitySummary">—</p>
                                </div>
                                <div class="po-category-priority" id="poCatEntityPriority">—</div>
                            </div>
                        </div>

                        <div class="po-sections">
                            <div class="po-section card" id="poSection-headings">
                                <div class="card-header"><h3><i class="fas fa-heading"></i> Missing headings</h3><span class="po-section-priority" id="poSecHeadingsPriority">—</span></div>
                                <div class="card-body" id="poSecHeadingsBody"></div>
                            </div>
                            <div class="po-section card" id="poSection-title-meta">
                                <div class="card-header"><h3><i class="fas fa-tag"></i> Title &amp; meta description</h3><span class="po-section-priority" id="poSecTitlePriority">—</span></div>
                                <div class="card-body" id="poSecTitleBody"></div>
                            </div>
                            <div class="po-section card" id="poSection-content-depth">
                                <div class="card-header"><h3><i class="fas fa-ruler-vertical"></i> Content depth gap</h3><span class="po-section-priority" id="poSecContentPriority">—</span></div>
                                <div class="card-body" id="poSecContentBody"></div>
                            </div>
                            <div class="po-section card" id="poSection-faqs">
                                <div class="card-header"><h3><i class="fas fa-circle-question"></i> FAQ coverage</h3><span class="po-section-priority" id="poSecFaqPriority">—</span></div>
                                <div class="card-body" id="poSecFaqBody"></div>
                            </div>
                            <div class="po-section card" id="poSection-schema">
