<div class="page" id="page-page-optimization">
                <div class="po-container">
                    <div class="card po-header">
                        <div class="card-body">
                            <div class="po-header-top">
                                <div>
                                    <h2 style="margin-bottom:6px"><i class="fas fa-bullseye"></i> Existing Page Optimization</h2>
                                    <p class="po-header-sub">Enter a URL and target keyword. We crawl your page plus the top 10 SERP competitors and surface 8 specific gaps you can fix today.</p>
                                </div>
                                <div class="po-header-stats" id="poHeaderStats" style="display:none">
                                    <div class="po-stat">
                                        <strong id="poStatMyScore">—</strong>
                                        <span>Your page score</span>
                                    </div>
                                    <div class="po-stat">
                                        <strong id="poStatCompScore">—</strong>
                                        <span>Competitor avg</span>
                                    </div>
                                    <div class="po-stat">
                                        <strong id="poStatHigh">—</strong>
                                        <span>High-priority gaps</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="po-grid">
                        <div class="card po-form-card">
                            <div class="card-header">
                                <h3>Optimize a page</h3>
                                <span class="header-hint">We'll crawl the live page, fetch the SERP, and compare against up to 10 competitors.</span>
                            </div>
                            <div class="card-body">
                                <div class="form-group">
                                    <label>Your page URL</label>
                                    <input type="text" id="poUrl" placeholder="https://yoursite.com/your-page">
                                </div>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>Target keyword</label>
                                        <input type="text" id="poKeyword" placeholder="e.g. web design company bangalore">
                                    </div>
                                    <div class="form-group">
                                        <label>Search location</label>
                                        <select id="poLocation">
                                            <option value="India">India</option>
                                            <option value="United States">United States</option>
                                            <option value="United Kingdom">United Kingdom</option>
                                            <option value="Bangalore">Bangalore</option>
                                            <option value="Mumbai">Mumbai</option>
                                            <option value="Delhi">Delhi</option>
                                            <option value="Dubai">Dubai</option>
                                            <option value="Singapore">Singapore</option>
                                        </select>
                                    </div>
                                </div>
                                <button class="btn btn-primary" id="poAnalyzeBtn">
                                    <i class="fas fa-bullseye"></i> Run Optimization Analysis
                                </button>
                            </div>
                        </div>

                        <div class="card po-history-card">
                            <div class="card-header">
                                <h3>Recent reports</h3>
                                <button class="btn btn-sm btn-outline" id="poRefreshHistoryBtn"><i class="fas fa-rotate-right"></i></button>
                            </div>
                            <div class="card-body" id="poHistoryList">
                                <p class="text-muted">No reports yet. Run your first analysis.</p>
                            </div>
                        </div>
                    </div>

                    <div id="poProgress" class="card po-progress" style="display:none">
                        <div class="card-body">
                            <div class="po-progress-step" id="poProgressStep">Starting analysis…</div>
                            <div class="po-progress-bar"><div class="po-progress-fill" id="poProgressFill"></div></div>
                            <div class="po-progress-detail" id="poProgressDetail"></div>
                        </div>
                    </div>

                    <div id="poErrorBanner" class="card po-error" style="display:none">
                        <div class="card-body" id="poErrorBody"></div>
                    </div>

                    <div id="poResults" style="display:none">
                        <div class="po-report-header card">
