<div class="page ed-page ed-report-page" id="page-reports">
    <section class="ed-page-header ed-report-header">
        <div>
            <p class="ed-eyebrow">Delivery / report workspace</p>
            <h2 class="ed-display" data-pretext>Build a report your client can trust.</h2>
            <p class="ed-page-description" data-pretext>Choose the client, set the period, review every source state, then save or export the draft.</p>
        </div>
        <div class="ed-report-header-note"><span class="ed-status-dot ed-status-dot-green"></span><span>Drafts keep their source trail</span></div>
    </section>

    <section class="ed-report-context" aria-label="Report workflow">
        <div class="ed-report-step is-active"><span>01</span><strong>Context</strong><small>Client and period</small></div>
        <div class="ed-report-step"><span>02</span><strong>Evidence</strong><small>Sources and freshness</small></div>
        <div class="ed-report-step"><span>03</span><strong>Decision</strong><small>Wins and issues</small></div>
        <div class="ed-report-step"><span>04</span><strong>Delivery</strong><small>Save and share</small></div>
    </section>

    <div class="ed-report-layout">
        <aside class="ed-report-builder" aria-labelledby="reportBuilderTitle">
            <div class="ed-panel-heading ed-builder-heading"><div><p class="ed-eyebrow">Context</p><h2 id="reportBuilderTitle">Report setup</h2></div><span class="ed-step-badge">01 / 04</span></div>
            <div class="ed-form-stack">
                <div class="ed-field"><label for="reportClientSelect">Client</label><select id="reportClientSelect"><option value="">Choose a client</option></select><small>Client context keeps data scoped to one account.</small></div>
                <div class="ed-field"><label for="reportDomain">Website domain</label><input type="text" id="reportDomain" name="reportDomain" placeholder="example.com…" autocomplete="url" inputmode="url" spellcheck="false"><small>Used for rank, crawl, and PageSpeed matching.</small></div>
                <div class="ed-field"><label for="reportTitle">Report title</label><input type="text" id="reportTitle" name="reportTitle" placeholder="Monthly SEO Report…" autocomplete="off" spellcheck="true"></div>
                <div class="ed-field"><label for="reportPeriod">Reporting period</label><select id="reportPeriod"><option value="30">Last 30 days</option><option value="60">Last 60 days</option><option value="90">Last 90 days</option><option value="7">Last 7 days</option></select></div>
                <label class="ed-checkbox-field" for="reportIncludePageSpeed"><input type="checkbox" id="reportIncludePageSpeed" checked><span><strong>Include PageSpeed</strong><small>Only show Core Web Vitals when a saved or live source is available.</small></span></label>
                <button class="ed-button ed-button-primary ed-button-wide" id="generateReportBtn" type="button"><i class="fas fa-wand-magic-sparkles"></i> Generate evidence draft</button>
                <div id="reportGenerating" class="ed-generating" style="display:none;" aria-live="polite"><span class="ed-spinner"></span><span>Collecting stored data and checking sources...</span></div>
            </div>
            <div class="ed-trust-note"><i class="fas fa-shield-halved"></i><div><strong>Accuracy rule</strong><p>Missing data stays visible as missing. We never turn a proxy into a measured score.</p></div></div>
        </aside>

        <main class="ed-report-main">
            <section class="ed-panel ed-source-overview" aria-labelledby="reportSourcesTitle">
                <div class="ed-panel-heading"><div><p class="ed-eyebrow">Evidence</p><h2 id="reportSourcesTitle">Source coverage</h2></div><button class="ed-text-button" type="button" data-evidence-trigger="report"><i class="fas fa-circle-info"></i> What each source means</button></div>
                <div class="ed-source-coverage" id="reportSourceCoverage">
                    <div class="ed-coverage-item"><span class="ed-coverage-icon"><i class="fas fa-key"></i></span><div><strong>Rank tracker</strong><small id="reportRankSourceState">Awaiting report</small></div></div>
                    <div class="ed-coverage-item"><span class="ed-coverage-icon"><i class="fas fa-spider"></i></span><div><strong>Technical crawl</strong><small id="reportTechnicalSourceState">Awaiting report</small></div></div>
                    <div class="ed-coverage-item"><span class="ed-coverage-icon"><i class="fas fa-gauge-high"></i></span><div><strong>PageSpeed</strong><small id="reportPageSpeedSourceState">Awaiting report</small></div></div>
                    <div class="ed-coverage-item"><span class="ed-coverage-icon"><i class="fas fa-chart-line"></i></span><div><strong>Search Console</strong><small id="reportGscSourceState">Awaiting report</small></div></div>
                </div>
            </section>

            <section class="ed-panel ed-report-preview" id="reportPreviewCard" style="display:none;" aria-labelledby="reportPreviewTitle">
                <div class="ed-panel-heading"><div><p class="ed-eyebrow">Decision draft</p><h2 id="reportPreviewTitle">Report preview</h2></div><div class="ed-panel-actions"><button class="ed-button ed-button-secondary ed-button-small" id="saveReportBtn" type="button"><i class="fas fa-floppy-disk"></i> Save draft</button><button class="ed-button ed-button-secondary ed-button-small" id="shareReportBtn" type="button" disabled title="Save the report before sharing"><i class="fas fa-link"></i> Share link</button><button class="ed-button ed-button-primary ed-button-small" id="openReportBtn" type="button"><i class="fas fa-arrow-up-right-from-square"></i> Open export</button></div></div>
                <div id="reportPreviewContent"></div>
            </section>

            <section class="ed-panel ed-saved-reports" aria-labelledby="savedReportsTitle">
                <div class="ed-panel-heading"><div><p class="ed-eyebrow">History</p><h2 id="savedReportsTitle">Saved reports</h2></div><button class="ed-text-button" type="button" onclick="loadSavedReports()"><i class="fas fa-rotate-right"></i> Refresh</button></div>
                <div id="savedReportsList"><p class="ed-empty-copy">No saved reports yet. Generate the first evidence draft above.</p></div>
            </section>

            <details class="ed-panel ed-scheduled-reports">
                <summary class="ed-details-summary"><span><span class="ed-eyebrow">Automation</span><strong>Scheduled delivery</strong><small>Keep email delivery separate from report truth and review.</small></span><i class="fas fa-chevron-down"></i></summary>
                <div class="ed-scheduled-body">
                    <div id="scheduledReportsSmtpStatus" class="ed-smtp-status"></div>
                    <div class="ed-schedule-form">
                        <div class="ed-field"><label for="schedDomain">Domain</label><input type="text" id="schedDomain" name="schedDomain" placeholder="example.com…" autocomplete="url" spellcheck="false" inputmode="url"></div>
                        <div class="ed-field"><label for="schedTitle">Report title</label><input type="text" id="schedTitle" name="schedTitle" placeholder="Monthly SEO Report…" autocomplete="off" spellcheck="true"></div>
                        <div class="ed-field"><label for="schedRecipients">Recipients</label><input type="text" id="schedRecipients" name="recipients" placeholder="client@example.com, manager@example.com…" autocomplete="email" spellcheck="false"></div>
                        <div class="ed-field"><label for="schedFrequency">Frequency</label><select id="schedFrequency"><option value="weekly">Weekly</option><option value="biweekly">Biweekly</option><option value="monthly" selected>Monthly</option></select></div>
                        <div class="ed-field"><label for="schedHour">Send hour</label><input type="number" id="schedHour" value="8" min="0" max="23"></div>
                        <div class="ed-field"><label for="schedDayOfMonth">Day of month</label><input type="number" id="schedDayOfMonth" value="1" min="1" max="28"></div>
                    </div>
                    <div class="ed-schedule-actions"><button class="ed-button ed-button-primary" type="button" onclick="createScheduledReport()"><i class="fas fa-calendar-plus"></i> Create schedule</button><button class="ed-button ed-button-secondary" type="button" onclick="sendTestEmail()"><i class="fas fa-paper-plane"></i> Send test</button></div>
                    <div id="scheduledReportsList"></div>
                </div>
            </details>
        </main>
    </div>
</div>
