<div class="page" id="page-reports">
                <div style="max-width: 1100px; margin: 0 auto; padding: 0 4px;">

                    <!-- Header -->
                    <div style="background: linear-gradient(135deg, #070613 0%, #7c3aeda1 100%); border-radius: 16px; padding: 32px 36px; margin-bottom: 28px; color: white; position: relative; overflow: hidden;">
                        <div style="position:absolute;top:-40px;right:-40px;width:160px;height:160px;border-radius:50%;background:rgba(255,255,255,0.07);"></div>
                        <div style="display:flex;align-items:center;gap:14px;margin-bottom:10px;">
                            <div style="width:48px;height:48px;background:rgba(255,255,255,0.15);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;">📊</div>
                            <div>
                                <h2 style="font-size:1.4rem;font-weight:800;margin:0;padding:0 0 8px 0;">Agency-Ready SEO Reports</h2>
                                <p style="opacity:0.85;font-size:13px;margin:0;">Generate professional PDF/HTML reports for your clients in seconds</p>
                            </div>
                        </div>
                        <div style="display:flex;gap:20px;flex-wrap:wrap;margin-top:14px;font-size:12px;opacity:0.8;">
                            <span>📄 Monthly SEO Report</span>
                            <span>📈 Keyword Movement</span>
                            <span>🔧 Technical Fixes</span>
                            <span>⚡ PageSpeed & Core Web Vitals</span>
                            <span>✍️ Content Recommendations</span>
                            <span>⚔️ Competitor Changes</span>
                            <span>🗓️ Next Month Plan</span>
                        </div>
                    </div>

                    <!-- Report Builder -->
                    <div style="display:grid;grid-template-columns:400px 1fr;gap:24px;align-items:start;">

                        <!-- Left: Form -->
                        <div class="card" style="position:sticky;top:20px;">
                            <div class="card-header" style="border-bottom:1px solid var(--border);padding-bottom:14px;margin-bottom:20px;">
                                <h3 style="margin:0;font-size:1rem;">⚙️ Report Builder</h3>
                            </div>
                            <div class="card-body" style="padding:0;">
                                <div class="form-group">
                                    <label style="font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;">Report Title</label>
                                    <input type="text" id="reportTitle" placeholder="Monthly SEO Report – June 2025" style="width:100%;">
                                </div>
                                <div class="form-group">
                                    <label style="font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;">Client</label>
                                    <select id="reportClientSelect" style="width:100%;">
                                        <option value="">No specific client (by domain)</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label style="font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;">Domain to Track</label>
                                    <input type="text" id="reportDomain" placeholder="yourdomain.com" style="width:100%;">
                                </div>
                                <div class="form-group">
                                    <label style="font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;">Report Period</label>
                                    <select id="reportPeriod" style="width:100%;">
                                        <option value="30">Last 30 days</option>
                                        <option value="60">Last 60 days</option>
                                        <option value="90">Last 90 days (Quarter)</option>
                                        <option value="7">Last 7 days</option>
                                    </select>
                                </div>
                                <label style="display:flex;align-items:flex-start;gap:10px;padding:12px;border:1px solid var(--border);border-radius:10px;background:var(--bg);font-size:13px;color:var(--text);margin-bottom:12px;">
                                    <input type="checkbox" id="reportIncludePageSpeed" checked style="margin-top:2px;">
                                    <span><strong>Include PageSpeed</strong><br><span style="font-size:12px;color:var(--text-muted);">Adds mobile PageSpeed and Core Web Vitals metrics when available.</span></span>
                                </label>
                                <button class="btn btn-primary" id="generateReportBtn" style="width:100%;justify-content:center;height:48px;font-size:0.95rem;font-weight:700;margin-top:8px;">
                                    <i class="fas fa-magic"></i> Generate Report
                                </button>
                                <div id="reportGenerating" style="display:none;text-align:center;padding:16px;color:var(--text-muted);font-size:13px;">
                                    <div style="display:inline-block;width:20px;height:20px;border:2px solid var(--brand);border-top-color:transparent;border-radius:50%;animation:spin 0.8s linear infinite;margin-right:8px;"></div>
                                    Generating full client report with PageSpeed and AI analysis...
                                </div>
                            </div>
                        </div>

                        <!-- Right: Preview & Saved Reports -->
                        <div>
                            <!-- Live Preview -->
                            <div class="card" id="reportPreviewCard" style="display:none;margin-bottom:20px;">
                                <div class="card-header" style="border-bottom:1px solid var(--border);padding-bottom:14px;margin-bottom:20px;display:flex;align-items:center;justify-content:space-between;">
                                    <h3 style="margin:0;font-size:1rem;">📋 Report Preview</h3>
                                    <div style="display:flex;gap:8px;">
                                        <button class="btn btn-sm btn-outline" id="saveReportBtn"><i class="fas fa-save"></i> Save</button>
                                        <button class="btn btn-sm btn-primary" id="openReportBtn"><i class="fas fa-external-link-alt"></i> Open Full Report</button>
                                    </div>
                                </div>
                                <div id="reportPreviewContent"></div>
                            </div>

                            <!-- Saved Reports -->
                            <div class="card">
                                <div class="card-header" style="border-bottom:1px solid var(--border);padding-bottom:14px;margin-bottom:20px;display:flex;align-items:center;justify-content:space-between;">
                                    <h3 style="margin:0;font-size:1rem;">🗂️ Saved Reports</h3>
                                    <button class="btn btn-sm btn-outline" onclick="loadSavedReports()"><i class="fas fa-rotate-right"></i> Refresh</button>
                                </div>
                                <div id="savedReportsList">
                                    <p style="color:var(--text-muted);font-size:13px;text-align:center;padding:20px;">No saved reports yet. Generate your first report above.</p>
                                </div>
                            </div>

                            <!-- Scheduled Email Reports -->
                            <div class="card" style="margin-top:20px;">
                                <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;">
                                    <h3 style="margin:0;font-size:1rem;"><i class="fas fa-envelope"></i> Scheduled Email Reports</h3>
                                    <button class="btn btn-sm btn-outline" onclick="loadScheduledReports()"><i class="fas fa-rotate-right"></i> Refresh</button>
                                </div>
                                <div class="card-body">
                                    <div id="scheduledReportsSmtpStatus" style="margin-bottom:12px;"></div>

                                    <!-- Create form -->
                                    <div style="background:var(--bg);border-radius:10px;padding:24px;margin-bottom:16px;">
                                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
                                            <div>
                                                <label style="font-size:12px;font-weight:600;display:block;margin-bottom:8px;text-transform:uppercase;letter-spacing:0.5px;">Domain</label>
                                                <input type="text" id="schedDomain" placeholder="example.com" class="form-control" style="width:100%;">
                                            </div>
                                            <div>
                                                <label style="font-size:12px;font-weight:600;display:block;margin-bottom:8px;text-transform:uppercase;letter-spacing:0.5px;">Report Title</label>
                                                <input type="text" id="schedTitle" placeholder="Monthly SEO Report" class="form-control" style="width:100%;">
                                            </div>
                                            <div>
                                                <label style="font-size:12px;font-weight:600;display:block;margin-bottom:8px;text-transform:uppercase;letter-spacing:0.5px;">Recipients (comma-separated)</label>
                                                <input type="text" id="schedRecipients" placeholder="client@example.com, manager@example.com" class="form-control" style="width:100%;">
                                            </div>
                                            <div>
                                                <label style="font-size:12px;font-weight:600;display:block;margin-bottom:8px;text-transform:uppercase;letter-spacing:0.5px;">Frequency</label>
                                                <select id="schedFrequency" class="form-control" style="width:100%;">
                                                    <option value="weekly">Weekly</option>
                                                    <option value="biweekly">Biweekly</option>
                                                    <option value="monthly" selected>Monthly</option>
                                                </select>
                                            </div>
                                            <div>
                                                <label style="font-size:12px;font-weight:600;display:block;margin-bottom:8px;text-transform:uppercase;letter-spacing:0.5px;">Send at Hour (0-23)</label>
                                                <input type="number" id="schedHour" value="8" min="0" max="23" class="form-control" style="width:100%;">
                                            </div>
                                            <div>
                                                <label style="font-size:12px;font-weight:600;display:block;margin-bottom:8px;text-transform:uppercase;letter-spacing:0.5px;">Day of Month (1-28)</label>
                                                <input type="number" id="schedDayOfMonth" value="1" min="1" max="28" class="form-control" style="width:100%;">
                                            </div>
                                        </div>
                                        <div style="display:flex;gap:12px;margin-top:20px;">
                                            <button class="btn btn-primary" onclick="createScheduledReport()" style="flex:1;"><i class="fas fa-plus"></i> Create Schedule</button>
                                            <button class="btn btn-outline" onclick="sendTestEmail()"><i class="fas fa-paper-plane"></i> Send Test</button>
                                        </div>
                                    </div>

                                    <!-- List -->
                                    <div id="scheduledReportsList"></div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>