<div class="page" id="page-tasks">
                <div style="max-width: 1200px; margin: 0 auto; padding: 0 4px;">
                    
                    <!-- Top control bar (Client/Project Selectors & Actions) -->
                    <div class="card" style="margin-bottom: 24px; padding: 20px;">
                        <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px;">
                            <div style="display: flex; flex-wrap: wrap; gap: 16px; align-items: center;">
                                <div class="form-group" style="margin: 0; min-width: 200px;">
                                    <label style="font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 6px;">Select Client</label>
                                    <select id="taskClientSelect" style="width: 100%; height: 40px;">
                                        <option value="">Choose a client...</option>
                                    </select>
                                </div>
                                <div class="form-group" style="margin: 0; min-width: 200px;">
                                    <label style="font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 6px;">Select Project</label>
                                    <select id="taskProjectSelect" style="width: 100%; height: 40px;" disabled>
                                        <option value="">Choose a project...</option>
                                    </select>
                                </div>
                            </div>
                            <div style="display: flex; gap: 12px; align-items: center;">
                                <button class="btn btn-outline" id="autoGenTasksBtn" style="height: 40px; font-weight: 600;" disabled>
                                    <i class="fas fa-magic" style="color: var(--brand);"></i> AI Auto-Generate
                                </button>
                                <button class="btn btn-primary" id="addCustomTaskBtn" style="height: 40px; font-weight: 600;" disabled>
                                    <i class="fas fa-plus"></i> Custom Task
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Task Statistics Summary cards -->
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 24px;">
                        <div class="card" style="padding: 16px 20px; display: flex; align-items: center; gap: 16px;">
                            <div style="width: 44px; height: 44px; background: rgba(79, 70, 229, 0.1); color: #4f46e5; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                                <i class="fas fa-list-check"></i>
                            </div>
                            <div>
                                <div style="font-size: 12px; color: var(--text-muted); font-weight: 500;">Total Tasks</div>
                                <div id="statTotalTasks" style="font-size: 1.5rem; font-weight: 700; color: var(--text);">0</div>
                            </div>
                        </div>
                        <div class="card" style="padding: 16px 20px; display: flex; align-items: center; gap: 16px;">
                            <div style="width: 44px; height: 44px; background: rgba(239, 68, 68, 0.1); color: #ef4444; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                                <i class="fas fa-fire"></i>
                            </div>
                            <div>
                                <div style="font-size: 12px; color: var(--text-muted); font-weight: 500;">Critical Priority</div>
                                <div id="statCriticalTasks" style="font-size: 1.5rem; font-weight: 700; color: #ef4444;">0</div>
                            </div>
                        </div>
                        <div class="card" style="padding: 16px 20px; display: flex; align-items: center; gap: 16px;">
                            <div style="width: 44px; height: 44px; background: rgba(245, 158, 11, 0.1); color: #f59e0b; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                                <i class="fas fa-spinner"></i>
                            </div>
                            <div>
                                <div style="font-size: 12px; color: var(--text-muted); font-weight: 500;">In Progress</div>
                                <div id="statInProgressTasks" style="font-size: 1.5rem; font-weight: 700; color: #f59e0b;">0</div>
                            </div>
                        </div>
                        <div class="card" style="padding: 16px 20px; display: flex; align-items: center; gap: 16px;">
                            <div style="width: 44px; height: 44px; background: rgba(16, 185, 129, 0.1); color: #10b981; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                                <i class="fas fa-circle-check"></i>
                            </div>
                            <div>
                                <div style="font-size: 12px; color: var(--text-muted); font-weight: 500;">Completed</div>
                                <div id="statCompletedTasks" style="font-size: 1.5rem; font-weight: 700; color: #10b981;">0</div>
                            </div>
                        </div>
                    </div>

                    <!-- Kanban Board columns -->
                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; align-items: start;" class="tasks-board-grid">
                        
                        <!-- Column: To Do -->
                        <div class="task-board-column">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span style="width: 8px; height: 8px; background: #6b7280; border-radius: 50%;"></span>
                                    <h4 style="margin: 0; font-size: 0.95rem; font-weight: 700; color: var(--text);">To Do</h4>
                                </div>
                                <span id="countTodo" style="font-size: 11px; font-weight: 600; background: var(--border); padding: 2px 8px; border-radius: 12px; color: var(--text-muted);">0</span>
                            </div>
                            <div id="columnTodo" style="display: flex; flex-direction: column; gap: 12px; flex-grow: 1;" class="task-column-container" data-status="todo">
                                <!-- Tasks injected here -->
                            </div>
                        </div>

                        <!-- Column: In Progress -->
                        <div class="task-board-column">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span style="width: 8px; height: 8px; background: #f59e0b; border-radius: 50%;"></span>
                                    <h4 style="margin: 0; font-size: 0.95rem; font-weight: 700; color: var(--text);">In Progress</h4>
                                </div>
                                <span id="countInProgress" style="font-size: 11px; font-weight: 600; background: rgba(245, 158, 11, 0.15); padding: 2px 8px; border-radius: 12px; color: #d97706;">0</span>
                            </div>
                            <div id="columnInProgress" style="display: flex; flex-direction: column; gap: 12px; flex-grow: 1;" class="task-column-container" data-status="in_progress">
                                <!-- Tasks injected here -->
                            </div>
                        </div>

                        <!-- Column: Completed -->
                        <div class="task-board-column">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span style="width: 8px; height: 8px; background: #10b981; border-radius: 50%;"></span>
                                    <h4 style="margin: 0; font-size: 0.95rem; font-weight: 700; color: var(--text);">Completed</h4>
                                </div>
                                <span id="countCompleted" style="font-size: 11px; font-weight: 600; background: rgba(16, 185, 129, 0.15); padding: 2px 8px; border-radius: 12px; color: #059669;">0</span>
                            </div>
                            <div id="columnCompleted" style="display: flex; flex-direction: column; gap: 12px; flex-grow: 1;" class="task-column-container" data-status="completed">
                                <!-- Tasks injected here -->
                            </div>
                        </div>

                    </div>

                </div>
            </div>